};

const FACE_SCALE = { wizard: 1, rain: 0.96, explorer: 1.06, forest: 1.21, space: 1.15, pajama: 0.93, dress: 1.09, winter: 1.03 };
function WanderingBangulee({ img, big, sprite, frames, base, stage, active, name, floor, costume, faces }) {
  const [x, setX] = React.useState(50);
  const [facing, setFacing] = React.useState(1);
  const [moving, setMoving] = React.useState(false);
  const [bubble, setBubble] = React.useState(null);
  const [reaction, setReaction] = React.useState(null);
  const [blink, setBlink] = React.useState(false);
  const [wf, setWf] = React.useState(0);
  const [mood, setMood] = React.useState(stage >= 4 ? 'sad' : 'normal');
  const s = React.useRef({ cur: 50, target: 50, phase: 'pause', until: 0, bubbleUntil: 0 });
  const MOOD_LINES = {
    normal: ['안녕! 방울이야~', '뭐하고 놀까?', '오늘도 반가워!'],
    happy: ['오늘도 촉촉~ ✨', '기분 최고야!', '뽀득뽀득!'],
    wink: ['물 아껴줘서 고마워! 😉', '우리 잘하고 있어~', '이대로만 가자!'],
    surprised: ['앗, 깜짝이야!', '오! 벌써 기록했어?', '우와, 물 아꼈네?'],
    sad: ['목이 좀 말라…', '물… 조금만 아껴줄래?', '기운이 없어…'],
    angry: ['물 펑펑 쓰면 안 돼! 😤', '조금만 아껴줘~', '아까워 아까워!'],
  };
  const LINES = costume && COSTUME_LINES[costume]
    ? Object.fromEntries(Object.keys(MOOD_LINES).map((k) => [k, (COSTUME_LINES[costume][k] || MOOD_LINES[k])]))
    : MOOD_LINES;
  const moodPool = stage <= 1 ? ['happy', 'wink', 'happy', 'normal']
    : stage <= 2 ? ['normal', 'wink', 'happy', 'surprised']
      : stage <= 3 ? ['normal', 'surprised', 'sad']
        : ['sad', 'angry', 'sad'];
  React.useEffect(() => {
    ['img/base_normal2.png','img/base_happy2.png','img/base_wink.png','img/base_surprised2.png','img/base_sad2.png','img/base_angry.png','img/face_normal.png','img/face_happy.png','img/face_blink.png','img/face_surprised.png','img/face_sad.png'].concat(faces ? Object.values(faces) : []).forEach((s) => { const i = new Image(); i.src = s; });
  }, [faces]);
  React.useEffect(() => {
    const driedNow = stage >= 4;
    if (!active) { setMoving(false); setBubble(null); setReaction(null); setMood(driedNow ? 'sad' : 'normal'); setX(50); setFacing(1); s.current.cur = 50; return; }
    let raf;
    setX(50); setFacing(1); setMoving(false); setMood(driedNow ? 'sad' : 'normal');
    s.current.until = performance.now() + 1400;
    const step = (now) => {
      const st = s.current;
      if (st.bubbleUntil && now > st.bubbleUntil) { setBubble(null); setMood(driedNow ? 'sad' : 'normal'); st.bubbleUntil = 0; }
      if (now > st.until) {
        st.until = now + 4200 + Math.random() * 3600;
        if (Math.random() < 0.8) {
          const m = moodPool[Math.floor(Math.random() * moodPool.length)];
          const lines = LINES[m];
          setMood(m);
          setBubble(lines[Math.floor(Math.random() * lines.length)]);
          st.bubbleUntil = now + 3600;
        }
      }
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }, [active, stage, costume]);
  React.useEffect(() => {
    if (!active) { setBlink(false); return; }
    let t;
    const loop = () => { t = setTimeout(() => { setBlink(true); setTimeout(() => setBlink(false), 150); loop(); }, 2600 + Math.random() * 3400); };
    loop();
    return () => clearTimeout(t);
  }, [active]);
  React.useEffect(() => {
    if (!frames || !active) { setWf(0); return; }
    const n = frames.walk.length;
    const id = setInterval(() => setWf((f) => (f + 1) % n), 140);
    return () => clearInterval(id);
  }, [frames, active]);
  const EXPR = { happy: '0% 0%', wink: '33.333% 0%', surprised: '66.667% 0%', sad: '100% 0%' };
  const dried = stage >= 4;
  const MOOD_TO_EXPR = { normal: 'normal', happy: 'happy', wink: 'happy', surprised: 'surprised', sad: 'sad', angry: 'surprised' };
  const MOOD_TO_POS = { normal: 'happy', happy: 'happy', wink: 'wink', surprised: 'surprised', sad: 'sad', angry: 'sad' };
  const pos = moving ? EXPR.happy : (EXPR[MOOD_TO_POS[mood] || (stage >= 4 ? 'sad' : 'happy')] || EXPR.happy);
  const spriteAnim = moving ? 'walkstep' : (stage <= 3 ? 'bob' : '');
  let expr;
  if (moving) expr = 'happy';
  else if (blink) expr = 'blink';
  else expr = MOOD_TO_EXPR[mood] || (dried ? 'sad' : 'normal');
  const FACES = { normal: 'img/face_normal.png', happy: 'img/face_happy.png', blink: 'img/face_blink.png', surprised: 'img/face_surprised.png', sad: 'img/face_sad.png' };
  const BASE_FACES = { normal: 'img/base_normal2.png', happy: 'img/base_happy2.png', wink: 'img/base_wink.png', surprised: 'img/base_surprised2.png', sad: 'img/base_sad2.png', angry: 'img/base_angry.png' };
  let frameSrc = null;
  if (frames) {
    frameSrc = frames.walk[wf % frames.walk.length];
  }
  const FH = big ? 170 : 150, FW = Math.round(FH * 0.87);
  const legH = Math.round(FH * 0.36), legW = Math.round(legH * 0.94);
  const armFH = Math.round(FH * 0.34), armFW = Math.round(armFH * 0.84);
  const armBH = Math.round(FH * 0.30), armBW = Math.round(armBH * 0.80);
  const drop = Math.round(FH * 0.12);
  const ppCls = 'pp' + (dried ? '' : (moving ? ' pp-walk' : ' pp-idle'));
  const puppet = (
    <div className={ppCls} style={{ position: 'relative', width: FW, height: FH + drop, margin: '0 auto' }}>
      <img src={FACES[expr]} alt={'방울이 ' + (name || '')} className="pp-body" style={{ position: 'absolute', width: FW, height: FH, left: 0, top: 0, zIndex: 3 }}><\u002Fimg>
    <\u002Fdiv>
  );
  const bubbleBottom = base ? (big ? 204 : 184) : (frames ? 228 : (sprite ? 212 : (big ? 192 : 170)));
  const bottomPx = (typeof floor === 'number') ? floor : (base ? 44 : ((sprite || frames) ? 40 : 58));
  return (
    <div style={{ position: 'absolute', left: x + '%', bottom: bottomPx, transform: 'translateX(-50%)', textAlign: 'center', transition: moving ? 'none' : 'left 0.25s ease', zIndex: 6, pointerEvents: 'none' }}>
      {bubble && (
        <div style={{ position: 'absolute', left: 0, right: 0, bottom: bubbleBottom, display: 'flex', justifyContent: 'center', pointerEvents: 'none' }}>
          <div className="popinc" style={{ position: 'relative', background: '#fff', borderRadius: 14, padding: '7px 13px', boxShadow: '0 3px 10px rgba(46,116,170,0.16)', fontSize: 12.5, fontWeight: 700, color: BGC.ink, whiteSpace: 'nowrap' }}>
            {bubble}
            <div style={{ position: 'absolute', bottom: -4, left: '50%', width: 9, height: 9, background: '#fff', transform: 'translateX(-50%) rotate(45deg)' }}><\u002Fdiv>
          <\u002Fdiv>
        <\u002Fdiv>
      )}
      <div style={{ transform: 'scaleX(' + ((frames && !faces) ? -facing : facing) + ')' }}>
        {faces ? (
          <img src={faces[mood] || faces.normal} alt={'방울이 ' + (name || '')} className={stage <= 3 ? 'bob' : ''} style={{ height: (big ? 200 : 178) * (FACE_SCALE[costume] || 1), display: 'block', margin: '0 auto' }}><\u002Fimg>
        ) : frames ? (
          <img src={frameSrc} alt={'방울이 ' + (name || '')} className={moving ? '' : (stage <= 3 ? 'bob' : '')} style={{ height: big ? 208 : 190, display: 'block', margin: '0 auto' }}><\u002Fimg>
        ) : sprite ? (
          <div className={spriteAnim} style={{ width: 105, height: 210, margin: '0 auto', backgroundImage: 'url(' + sprite + ')', backgroundSize: '400% 200%', backgroundPosition: pos, backgroundRepeat: 'no-repeat' }}><\u002Fdiv>
        ) : base ? (
          <img src={BASE_FACES[mood] || BASE_FACES.normal} alt={'방울이 ' + (name || '')} className={stage <= 3 ? 'bob' : ''} style={{ height: big ? 176 : 156, display: 'block', margin: '0 auto' }}><\u002Fimg>
        ) : (
          <img src={img} alt={'방울이 ' + (name || '')} className={moving ? 'walkstep' : (stage <= 3 ? 'bob' : '')} style={{ height: big ? 172 : 150, display: 'block', margin: '0 auto' }}><\u002Fimg>
        )}
      <\u002Fdiv>
      <div style={{ width: faces ? 78 : (base ? Math.round(FW * 0.62) : (frames ? 86 : (sprite ? 82 : 110))), height: 13, borderRadius: '50%', background: 'rgba(120,90,30,0.18)', margin: (faces ? '-2px' : (base ? '-4px' : (frames ? '-8px' : (sprite ? '-16px' : '2px')))) + ' auto 0' }}><\u002Fdiv>
    <\u002Fdiv>
  );
}

function Chip({ icon, color = BGC.skyDeep, bg = '#EAF5FD', children }) {
  return (
    <div style={{
      display: 'inline-flex', alignItems: 'center', gap: 5, background: bg,
      borderRadius: 99, padding: '5px 11px', fontSize: 12.5, fontWeight: 700, color,
    }}>
      {icon && <MIcon name={icon} size={15} color={color}><\u002FMIcon>}
      {children}
    <\u002Fdiv>
  );
}

function Segmented({ options, value, onChange }) {
  return (
    <div style={{ display: 'flex', gap: 4, background: '#E2F1FC', borderRadius: 14, padding: 4 }}>
      {options.map((o) => (
        <button key={o} className="press" onClick={() => onChange(o)} style={{
          flex: 1, border: 'none', borderRadius: 11, padding: '8px 0', cursor: 'pointer',
          fontFamily: 'Jua', fontSize: 13.5, whiteSpace: 'nowrap',
          background: o === value ? '#fff' : 'transparent',
          color: o === value ? BGC.skyDeep : BGC.sub,
          boxShadow: o === value ? '0 2px 6px rgba(46,116,170,0.18)' : 'none',
        }}>{o}<\u002Fbutton>
      ))}
    <\u002Fdiv>
  );
}

function ScreenHead({ title, sub, right }) {
  return (
    <div style={{ display: 'flex', alignItems: 'flex-start', padding: '14px 20px 4px' }}>
      <div style={{ flex: 1 }}>
        <div className="jua" style={{ fontSize: 23, color: BGC.ink }}>{title}<\u002Fdiv>
        {sub && <div style={{ fontSize: 13, color: BGC.sub, marginTop: 3 }}>{sub}<\u002Fdiv>}
      <\u002Fdiv>
      {right}
    <\u002Fdiv>
  );
}

const NAV_ITEMS = [
  { id: 'home', icon: 'home', label: '홈' },
  { id: 'ledger', icon: 'receipt_long', label: '가계부' },
  { id: 'report', icon: 'monitoring', label: '리포트' },
  { id: 'shop', icon: 'storefront', label: '상점' },
];

function BottomNav({ active, onNav }) {
  const item = (it) => {
    const on = active === it.id;
    return (
      <button key={it.id} className="press" onClick={() => onNav(it.id)} style={{
        flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 2,
        background: 'none', border: 'none', cursor: 'pointer', padding: '8px 0 6px',
        color: on ? BGC.skyDeep : '#9FB9CC',
      }}>
        <MIcon name={it.icon} size={25} fill={on ? 1 : 0}><\u002FMIcon>
        <span style={{ fontSize: 11, fontWeight: on ? 800 : 600 }}>{it.label}<\u002Fspan>
      <\u002Fbutton>
    );
  };
  return (
    <div style={{ position: 'relative', background: '#fff', borderTop: `1.5px solid ${BGC.line}` }}>
      <div style={{ display: 'flex', alignItems: 'stretch', padding: '0 4px' }}>
        {item(NAV_ITEMS[0])}{item(NAV_ITEMS[1])}
        <div style={{ width: 92 }}><\u002Fdiv>
        {item(NAV_ITEMS[2])}{item(NAV_ITEMS[3])}
      <\u002Fdiv>
      <button className="press" onClick={() => onNav('camera')} aria-label="계량기 촬영" style={{
        position: 'absolute', left: '50%', top: -36, transform: 'translateX(-50%)',
        width: 78, height: 78, borderRadius: '50%', cursor: 'pointer',
        background: `linear-gradient(180deg, #FFDD63, ${BGC.yellow})`,
        border: '5px solid #fff',
        boxShadow: '0 9px 20px rgba(33,68,89,0.32), 0 0 0 7px rgba(255,206,51,0.20)',
        display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 1,
      }}>
        <MIcon name="photo_camera" size={32} color="#7A5A0A"><\u002FMIcon>
        <span className="jua" style={{ fontSize: 14, color: '#7A5A0A', lineHeight: 1 }}>검침<\u002Fspan>
      <\u002Fbutton>
    <\u002Fdiv>
  );
}

Object.assign(window, {
  BGC, MIcon, PhoneFrame, Card, CoinChip, PrimaryBtn, GhostBtn, SectionLabel,
  WaterBar, MoistureDots, SpeechBubble, Chip, Segmented, ScreenHead, BottomNav,
});

<\u002Fscript>
<script type="text/babel">
// 방울이 — 온보딩 + 홈 화면
const { useState, useEffect, useRef } = React;

function Onboarding({ onDone }) {
  const [page, setPage] = useState(0);
  const [house, setHouse] = useState('4인 이상');
  const goal = BG.GOAL_BY_HOUSEHOLD[house];

  const slides = [
    {
      visual: <img src="data:image/png;base64," alt="방울이" className="bob" style={{ height: 200 }}><\u002Fimg>,
      title: '만나서 반가워요,\n방울이예요!',
      sub: '수도 계량기를 찰칵 찍으면\n오늘 쓴 물이 자동으로 기록돼요.',
    },
    {
      visual: (
        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
          {[['water_drop', '#2E86C9', '#EAF5FD', '물 절약'],
            ['bolt', '#B8860B', '#FFF6D8', '에너지 절감'],
            ['co2', '#3FAE7C', '#E8F6EF', '탄소 감축']].map(([ic, c, b, label], i) => (
            <React.Fragment key={ic}>
              {i > 0 && <MIcon name="arrow_forward" size={20} color="#A9C6DB"><\u002FMIcon>}
              <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                <div style={{ width: 74, height: 74, borderRadius: '50%', background: b, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <MIcon name={ic} size={36} color={c}><\u002FMIcon>
                <\u002Fdiv>
                <span style={{ fontSize: 12.5, fontWeight: 700, color: BGC.ink }}>{label}<\u002Fspan>
              <\u002Fdiv>
            <\u002FReact.Fragment>
          ))}
        <\u002Fdiv>
      ),
      title: '물을 아끼면\n에너지·탄소도 줄어요',
      sub: '물 1㎥ 뒤에는 약 0.68kWh의 전력과\n온수를 데우는 보일러 에너지가 숨어 있어요.',
    },
    {
      visual: (
        <div style={{ display: 'flex', alignItems: 'flex-end', gap: 4 }}>
          {BG.STAGES.map((s, i) => (
            <React.Fragment key={s.n}>
              {i > 0 && <MIcon name="chevron_right" size={16} color="#A9C6DB" style={{ marginBottom: 28 }}><\u002FMIcon>}
              <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 5 }}>
                <img src={s.img} alt={s.name} style={{ height: 64 - i * 4 }}><\u002Fimg>
                <span style={{ fontSize: 10.5, fontWeight: 700, color: BGC.sub }}>{s.n}단계<\u002Fspan>
              <\u002Fdiv>
            <\u002FReact.Fragment>
          ))}
        <\u002Fdiv>
      ),
      title: '기록을 잊으면\n방울이가 말라가요',
      sub: '매일 기록해서 촉촉함을 지켜주세요.\n절약하면 나무코인으로 꾸밀 수도 있어요!',
    },
    {
      visual: <img src="data:image/png;base64," alt="방울이 윙크" className="bob" style={{ height: 160 }}><\u002Fimg>,
      title: '몇 명이 함께 사나요?',
      sub: '가구원 수에 맞춰 하루 물 목표를 정해드려요.',
    },
  ];
  const last = page === slides.length - 1;
  const s = slides[page];

  return (
    <PhoneFrame bg="#F6FBFF">
      <div data-screen-label={'온보딩 ' + (page + 1)} style={{ flex: 1, minHeight: 0, display: 'flex', flexDirection: 'column', padding: '4px 26px 26px' }}>
        <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
          <button className="press" onClick={() => onDone(house)} style={{ background: 'none', border: 'none', color: BGC.sub, fontSize: 13.5, fontWeight: 700, cursor: 'pointer', padding: 8 }}>건너뛰기<\u002Fbutton>
        <\u002Fdiv>
        <div key={page} className="fade-up" style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 26, textAlign: 'center' }}>
          <div style={{ minHeight: 210, display: 'flex', alignItems: 'flex-end' }}>{s.visual}<\u002Fdiv>
          <div>
            <div className="jua" style={{ fontSize: 26, color: BGC.ink, whiteSpace: 'pre-line', lineHeight: 1.35 }}>{s.title}<\u002Fdiv>
            <div style={{ fontSize: 14.5, color: BGC.sub, whiteSpace: 'pre-line', lineHeight: 1.6, marginTop: 12 }}>{s.sub}<\u002Fdiv>
          <\u002Fdiv>
          {last && (
            <div style={{ width: '100%' }}>
              <div style={{ display: 'flex', gap: 8 }}>
                {Object.keys(BG.GOAL_BY_HOUSEHOLD).map((h) => (
                  <button key={h} className="press" onClick={() => setHouse(h)} style={{
                    flex: 1, padding: '12px 0', borderRadius: 14, cursor: 'pointer', fontFamily: 'Jua', fontSize: 15,
                    border: h === house ? `2px solid ${BGC.skyDeep}` : `2px solid ${BGC.line}`,
                    background: h === house ? '#EAF5FD' : '#fff',
                    color: h === house ? BGC.skyDeep : BGC.sub,
                  }}>{h}<\u002Fbutton>
                ))}
              <\u002Fdiv>
              <div style={{ marginTop: 12, fontSize: 13.5, fontWeight: 700, color: BGC.skyDeep }}>하루 물 목표 {goal}L<\u002Fdiv>
            <\u002Fdiv>
          )}
        <\u002Fdiv>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 18, alignItems: 'center' }}>
          <div style={{ display: 'flex', gap: 7 }}>
            {slides.map((_, i) => (
              <div key={i} style={{ width: i === page ? 22 : 8, height: 8, borderRadius: 99, background: i === page ? BGC.sky : '#CFE5F5', transition: 'width .25s' }}><\u002Fdiv>
            ))}
          <\u002Fdiv>
          <PrimaryBtn icon={last ? 'water_drop' : undefined} onClick={() => (last ? onDone(house) : setPage(page + 1))}>
            {last ? '방울이 키우기 시작!' : '다음'}
          <\u002FPrimaryBtn>
        <\u002Fdiv>
      <\u002Fdiv>
    <\u002FPhoneFrame>
  );
}

function ClosetSheet({ owned, equipped, onEquip, onClose, onNav }) {
  const ownedCostumes = COSTUMES.filter((c) => owned.includes(c.id));
  return (
    <div onClick={onClose} style={{
      position: 'fixed', inset: 0, zIndex: 60, background: 'rgba(20,45,65,0.45)',
      display: 'flex', flexDirection: 'column', justifyContent: 'flex-end',
    }}>
      <div className="sheet-up" onClick={(e) => e.stopPropagation()} style={{
        background: '#fff', borderRadius: '24px 24px 0 0', padding: '14px 18px 26px', maxHeight: '78%', overflowY: 'auto',
      }}>
        <div style={{ width: 40, height: 4, borderRadius: 99, background: '#D9E7F2', margin: '0 auto 12px' }}><\u002Fdiv>
        <div style={{ display: 'flex', alignItems: 'center', marginBottom: 14 }}>
          <span className="jua" style={{ flex: 1, fontSize: 19, color: BGC.ink }}>방울이 옷장<\u002Fspan>
          <button className="press" onClick={onClose} style={{ background: '#F1F7FC', border: 'none', borderRadius: 10, width: 34, height: 34, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
            <MIcon name="close" size={19} color={BGC.sub}><\u002FMIcon>
          <\u002Fbutton>
        <\u002Fdiv>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 10 }}>
          <button className="press" onClick={() => onEquip(null)} style={{
            background: !equipped ? '#EAF5FD' : '#fff', border: !equipped ? `2px solid ${BGC.skyDeep}` : `2px solid ${BGC.line}`,
            borderRadius: 16, padding: '10px 6px', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6,
          }}>
            <div style={{ height: 70, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
              <img src="data:image/png;base64," alt="기본" style={{ height: 64 }}><\u002Fimg>
            <\u002Fdiv>
            <span style={{ fontSize: 12, fontWeight: 800, color: !equipped ? BGC.skyDeep : BGC.sub }}>기본 모습<\u002Fspan>
          <\u002Fbutton>
          {ownedCostumes.map((c) => {
            const on = equipped === c.id;
            return (
              <button key={c.id} className="press" onClick={() => onEquip(c.id)} style={{
                background: on ? '#E8F6EF' : '#fff', border: on ? '2px solid #6FC59A' : `2px solid ${BGC.line}`,
                borderRadius: 16, padding: '10px 6px', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6,
              }}>
                <div style={{ height: 74, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <img src={c.img} alt={c.name} style={{ maxHeight: 72, maxWidth: 60, objectFit: 'contain' }}><\u002Fimg>
                <\u002Fdiv>
                <span style={{ fontSize: 11.5, fontWeight: 800, color: on ? '#2C8A60' : BGC.ink, textAlign: 'center', lineHeight: 1.25 }}>{c.name.replace(' 세트', '')}<\u002Fspan>
              <\u002Fbutton>
            );
          })}
        <\u002Fdiv>
        <button className="press" onClick={() => { onClose(); onNav('shop'); }} style={{
          width: '100%', marginTop: 14, minHeight: 48, borderRadius: 16, cursor: 'pointer',
          background: '#fff', border: `2px solid ${BGC.line}`, color: BGC.skyDeep,
          fontFamily: 'Jua', fontSize: 15, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 7,
        }}>
          <MIcon name="storefront" size={19} color={BGC.skyDeep}><\u002FMIcon>
          상점에서 새 옷 보기
        <\u002Fbutton>
      <\u002Fdiv>
    <\u002Fdiv>
  );
}

function HomeScreen({ app }) {
  const { stage, recorded, usage, goal, coins, streak, tip, house, userName, dolphinName, onNav, onManual, wornImg, sprite, frames, faces, owned, equipped, onEquip, placedItems, decorPos, onMoveDecor, room } = app;
  const roomRef = useRef(null);
  const themeKey = room && room.theme ? room.theme : null;
  const theme = themeKey && ROOM_THEMES[themeKey] ? ROOM_THEMES[themeKey] : null;
  const themeBg = theme ? theme.bg : null;
  const darkRoom = themeKey === 'night';
  const BAR_SKIN = {
    wood:  { bg: 'rgba(252,228,198,0.86)', ink: '#6B4A28' },
    green: { bg: 'rgba(228,231,184,0.86)', ink: '#4B6A32' },
    night: { bg: 'rgba(17,29,55,0.68)',    ink: '#EAF1FF' },
    pink:  { bg: 'rgba(254,220,205,0.86)', ink: '#B24A57' },
  };
  const barSkin = (themeKey && BAR_SKIN[themeKey]) ? BAR_SKIN[themeKey] : { bg: 'rgba(255,255,255,0.82)', ink: BGC.ink };
  const [editMode, setEditMode] = useState(false);
  const st = BG.STAGES[stage - 1];
  const e = BG.energyOf(usage);
  const moisture = Math.max(1, 6 - stage);
  const [closet, setCloset] = useState(false);
  useEffect(() => { if (app.startEdit) { setEditMode(true); app.clearStartEdit && app.clearStartEdit(); } }, [app.startEdit]);

  return (
    <div data-screen-label="홈" className="fade-up" style={{ padding: '6px 18px 100px' }}>
      {/* 헤더 */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '6px 2px 12px' }}>
        <div style={{ flex: 1, display: 'flex', alignItems: 'baseline', gap: 8 }}>
          <span className="jua" style={{ fontSize: 24, color: BGC.ink }}>{(dolphinName || '방울이')}네<\u002Fspan>
          <span style={{ fontSize: 12.5, fontWeight: 700, color: BGC.sub }}>{userName ? userName + ' · ' : ''}{house} 가구<\u002Fspan>
        <\u002Fdiv>
        <CoinChip n={coins}><\u002FCoinChip>
        <button className="press" onClick={() => onNav('settings')} aria-label="설정" style={{ background: '#fff', border: `1.5px solid ${BGC.line}`, borderRadius: 12, width: 36, height: 36, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
          <MIcon name="settings" size={20} color={BGC.sub} fill={0}><\u002FMIcon>
        <\u002Fbutton>
      <\u002Fdiv>

      {/* 방울이 방 */}
      <div ref={roomRef} style={{
        position: 'relative', borderRadius: 26, overflow: 'hidden', minHeight: 520,
        background: theme ? theme.wall : 'linear-gradient(180deg, #DCEAF6 0%, #E9F2FA 58%, #E7D2AC 58%, #DCC399 100%)',
        border: '1.5px solid #CBE6F8', display: 'flex', flexDirection: 'column', alignItems: 'center',
      }}>
        {themeBg ? (
          <div style={{ position: 'absolute', left: 0, right: 0, top: 0, bottom: 46, backgroundImage: 'url(' + themeBg + ')', backgroundSize: '100% auto', backgroundPosition: 'bottom center', backgroundRepeat: 'no-repeat' }}><\u002Fdiv>
        ) : (
          <React.Fragment>
            <div style={{ position: 'absolute', left: 0, right: 0, top: '58%', height: 7, background: '#CDB488', boxShadow: '0 2px 4px rgba(120,90,30,0.15)' }}><\u002Fdiv>
            <div style={{ position: 'absolute', left: 0, right: 0, top: 'calc(58% + 7px)', bottom: 0, backgroundImage: 'repeating-linear-gradient(90deg, rgba(150,110,55,0.10) 0 1px, transparent 1px 60px)' }}><\u002Fdiv>
            <RoomWindow th={null} style={{ top: 132, left: 18 }}><\u002FRoomWindow>
            <div style={{ position: 'absolute', left: '50%', bottom: 82, transform: 'translateX(-50%)', width: 190, height: 54, borderRadius: '50%', background: 'radial-gradient(ellipse at center, #F4C9A6 0%, #ECB890 60%, #E0A878 100%)', border: '3px solid #F7E7D2', boxShadow: '0 4px 10px rgba(120,90,30,0.15)' }}><\u002Fdiv>
          <\u002FReact.Fragment>
        )}
        <div style={{ position: 'absolute', top: 14, right: 14 }}>
          <Chip icon="water_drop" color={stage <= 2 ? BGC.skyDeep : BGC.orange} bg="rgba(255,255,255,0.9)">{st.n}단계 · {st.name}<\u002FChip>
        <\u002Fdiv>

        <div style={{ marginTop: 52, width: '82%' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8, background: 'rgba(255,255,255,0.92)', borderRadius: 16, padding: '11px 15px', boxShadow: '0 3px 12px rgba(46,116,170,0.14)' }}>
            <MIcon name={stage >= 4 ? 'sentiment_dissatisfied' : (stage <= 1 ? 'sentiment_very_satisfied' : 'water_drop')} size={20} color={stage >= 4 ? BGC.orange : BGC.skyDeep}><\u002FMIcon>
            <span style={{ fontSize: 13, fontWeight: 700, color: BGC.ink, lineHeight: 1.35, textAlign: 'center', textWrap: 'pretty' }}>{st.msg}<\u002Fspan>
          <\u002Fdiv>
        <\u002Fdiv>

        <WanderingBangulee img={st.img} sprite={sprite} frames={frames} faces={faces} base={!equipped} costume={equipped} big={false} stage={stage} active={!editMode && stage <= 3} name={st.name} floor={96}><\u002FWanderingBangulee>

        {/* 편집 모드 안내 + 배치 경계선 */}
        {editMode && (
          <div style={{ position: 'absolute', left: 0, right: 0, top: DECOR_MIN_TOP, borderTop: '2px dashed rgba(46,116,170,0.55)', pointerEvents: 'none', zIndex: 20 }}>
            <span style={{ position: 'absolute', right: 8, top: -10, background: BGC.skyDeep, color: '#fff', fontSize: 10, fontWeight: 800, padding: '2px 8px', borderRadius: 99 }}>이 아래로 배치<\u002Fspan>
          <\u002Fdiv>
        )}
        {editMode && (
          <div style={{ position: 'absolute', top: 52, left: '50%', transform: 'translateX(-50%)', background: 'rgba(20,50,80,0.82)', color: '#fff', fontSize: 12, fontWeight: 700, padding: '6px 13px', borderRadius: 99, zIndex: 25, whiteSpace: 'nowrap' }}>가구를 끌어 배치하세요<\u002Fdiv>
        )}

        {placedItems.map(({ id, img, size }, idx) => {
          const def = DECOR_POS[id] || { left: 18 + (idx % 4) * 84, top: 300 + Math.floor(idx / 4) * 70 };
          const initial = (decorPos && decorPos[id]) || def;
          if (editMode) {
            return <DraggableDecor key={id} id={id} src={img} size={size} initial={initial} roomRef={roomRef} onEnd={onMoveDecor}><\u002FDraggableDecor>;
          }
          return <CleanImg key={id} src={img} alt="" style={{ position: 'absolute', left: initial.left, top: initial.top, height: size, width: 'auto', pointerEvents: 'none', filter: 'drop-shadow(0 3px 5px rgba(0,0,0,0.2))' }}><\u002FCleanImg>;
        })}

        <div style={{
          position: 'absolute', left: 0, right: 0, bottom: 0, padding: '10px 16px',
          background: barSkin.bg, backdropFilter: 'blur(3px)',
          display: 'flex', alignItems: 'center', gap: 10,
        }}>
          <span style={{ fontSize: 12.5, fontWeight: 800, color: barSkin.ink }}>촉촉도<\u002Fspan>
          <MoistureDots filled={moisture}><\u002FMoistureDots>
          <div style={{ flex: 1 }}><\u002Fdiv>
          <Chip icon="local_fire_department" color="#C26A1B" bg="#FDEFD9">연속 {streak}일 기록<\u002FChip>
        <\u002Fdiv>
      <\u002Fdiv>

      {/* 방 꾸미기 / 옷 갈아입기 */}
      <div style={{ display: 'flex', gap: 10, marginTop: 12 }}>
        <button className="press" onClick={() => setEditMode((v) => !v)} style={{ flex: 1, minHeight: 46, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6, borderRadius: 16, cursor: 'pointer', background: editMode ? BGC.sky : '#fff', border: editMode ? 'none' : '1.5px solid #CBE6F8', boxShadow: '0 2px 6px rgba(46,116,170,0.12)' }}>
          <MIcon name={editMode ? 'check' : 'edit'} size={19} color={editMode ? '#fff' : BGC.skyDeep}><\u002FMIcon>
          <span className="jua" style={{ fontSize: 14.5, color: editMode ? '#fff' : BGC.skyDeep }}>{editMode ? '완료' : '방 꾸미기'}<\u002Fspan>
        <\u002Fbutton>
        <button className="press" onClick={() => setCloset(true)} style={{ flex: 1, minHeight: 46, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6, borderRadius: 16, cursor: 'pointer', background: '#fff', border: '1.5px solid #CBE6F8', boxShadow: '0 2px 6px rgba(46,116,170,0.12)' }}>
          <MIcon name="checkroom" size={19} color={BGC.skyDeep}><\u002FMIcon>
          <span className="jua" style={{ fontSize: 14.5, color: BGC.skyDeep }}>옷 갈아입기<\u002Fspan>
        <\u002Fbutton>
      <\u002Fdiv>

      {/* 오늘 기록 — 물 가계부 제거됨 */}
      {false && (
      <div style={{ marginTop: 14 }}>
        {recorded ? (
          <Card>
            <SectionLabel icon="receipt_long" right={
              usage <= goal
                ? <Chip icon="check_circle" color="#2C8A60" bg="#E8F6EF">목표 달성!<\u002FChip>
                : <Chip icon="error" color="#C26A1B" bg="#FDEFD9">목표 초과<\u002FChip>
            }>오늘의 물 가계부<\u002FSectionLabel>
            <div style={{ display: 'flex', alignItems: 'baseline', gap: 6 }}>
              <span className="jua" style={{ fontSize: 38, color: BGC.skyDeep }}>{usage.toLocaleString()}L<\u002Fspan>
              <span style={{ fontSize: 13.5, fontWeight: 700, color: BGC.sub }}>/ 목표 {goal}L<\u002Fspan>
            <\u002Fdiv>
            <div style={{ margin: '10px 0 12px' }}>
              <WaterBar value={usage} goal={goal}><\u002FWaterBar>
            <\u002Fdiv>
            <div style={{ display: 'flex', gap: 7, flexWrap: 'wrap' }}>
              <Chip icon="bolt" color="#B8860B" bg="#FFF6D8">에너지 {BG.fmt1(e.total)}kWh<\u002FChip>
              <Chip icon="co2" color="#2C8A60" bg="#E8F6EF">CO₂ {BG.fmt1(e.co2)}kg<\u002FChip>
              <Chip icon="battery_charging_full" color={BGC.skyDeep}>폰 충전 {e.phoneCharges}회<\u002FChip>
            <\u002Fdiv>
          <\u002FCard>
        ) : (
          <Card style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
            <img src="data:image/png;base64," alt="방울이" style={{ height: 64 }}><\u002Fimg>
            <div style={{ flex: 1 }}>
              <div className="jua" style={{ fontSize: 17, color: BGC.ink }}>오늘 아직 기록 전이에요!<\u002Fdiv>
              <div style={{ fontSize: 12.5, color: BGC.sub, marginTop: 2 }}>계량기를 찍으면 10초면 끝나요.<\u002Fdiv>
              <PrimaryBtn icon="photo_camera" onClick={() => onNav('camera')} style={{ minHeight: 44, marginTop: 10, fontSize: 15.5 }}>계량기 촬영하기<\u002FPrimaryBtn>
            <\u002Fdiv>
          <\u002FCard>
        )}
      <\u002Fdiv>
      )}

      {/* 절약 팁 */}
      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="tips_and_updates" right={<Chip color="#C26A1B" bg="#FDEFD9">{tip.when}<\u002FChip>}>방울이의 절약 팁<\u002FSectionLabel>
        <div style={{ fontSize: 13.5, color: BGC.ink, lineHeight: 1.6 }}>{tip.text}<\u002Fdiv>
      <\u002FCard>

      {closet && <ClosetSheet owned={owned} equipped={equipped} onEquip={(id) => { onEquip(id); setCloset(false); }} onClose={() => setCloset(false)} onNav={onNav}><\u002FClosetSheet>}
    <\u002Fdiv>
  );
}

Object.assign(window, { Onboarding, HomeScreen });

<\u002Fscript>
<script type="text/babel">
// 방울이 — 계량기 촬영 → OCR 인식 → 다이얼 보정 → 기록 완료 플로우
const { useState, useEffect } = React;

function MeterFace({ digits, scale = 1 }) {
  return (
    <div style={{
      width: 220 * scale, height: 220 * scale, borderRadius: '50%', background: '#26415C',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      boxShadow: 'inset 0 0 0 7px #18293B, 0 8px 22px rgba(0,0,0,0.35)', flexShrink: 0,
    }}>
      <div style={{
        width: 178 * scale, height: 178 * scale, borderRadius: '50%', background: '#F2F6F9',
        display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 9 * scale,
      }}>
        <div style={{ fontSize: 9.5 * scale, letterSpacing: 2.5, color: '#7A8FA3', fontWeight: 700 }}>SMART METER<\u002Fdiv>
        <div style={{ display: 'flex', gap: 2.5 * scale }}>
          {digits.split('').map((d, i) => (
            <div key={i} style={{
              width: 19 * scale, height: 29 * scale, borderRadius: 4 * scale,
              background: i < 4 ? '#1E2D3D' : '#B8443A', color: '#fff',
              fontFamily: 'Jua', fontSize: 19 * scale,
              display: 'flex', alignItems: 'center', justifyContent: 'center',
            }}>{d}<\u002Fdiv>
          ))}
        <\u002Fdiv>
        <div style={{ fontSize: 10.5 * scale, color: '#7A8FA3', fontWeight: 700 }}>
          m³ <span style={{ color: '#B8443A' }}>· 빨간 칸은 L<\u002Fspan>
        <\u002Fdiv>
      <\u002Fdiv>
    <\u002Fdiv>
  );
}

function DialCol({ val, red, flagged, onChange }) {
  const c = red ? '#B8443A' : BGC.ink;
  return (
    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4 }}>
      <button className="dial-btn press" onClick={() => onChange((val + 1) % 10)} aria-label="올리기">
        <MIcon name="keyboard_arrow_up" size={20} color={BGC.sub}><\u002FMIcon>
      <\u002Fbutton>
      <div style={{
        position: 'relative', width: 41, borderRadius: 12, background: '#fff', textAlign: 'center', padding: '3px 0',
        border: flagged ? '2.5px solid #F5A623' : `2px solid ${red ? '#EBC6C2' : BGC.line}`,
        boxShadow: flagged ? '0 0 0 4px #FFF1CF' : 'none',
      }}>
        <div className="jua" style={{ fontSize: 13, color: '#C3D5E2', lineHeight: '15px' }}>{(val + 9) % 10}<\u002Fdiv>
        <div className="jua" style={{ fontSize: 27, color: c, lineHeight: '30px' }}>{val}<\u002Fdiv>
        <div className="jua" style={{ fontSize: 13, color: '#C3D5E2', lineHeight: '15px' }}>{(val + 1) % 10}<\u002Fdiv>
        {flagged && (
          <div style={{
            position: 'absolute', top: -9, right: -9, width: 18, height: 18, borderRadius: '50%',
            background: '#F5A623', color: '#fff', fontSize: 11, fontWeight: 800,
            display: 'flex', alignItems: 'center', justifyContent: 'center',
          }}>?<\u002Fdiv>
        )}
      <\u002Fdiv>
      <button className="dial-btn press" onClick={() => onChange((val + 9) % 10)} aria-label="내리기">
        <MIcon name="keyboard_arrow_down" size={20} color={BGC.sub}><\u002FMIcon>
      <\u002Fbutton>
    <\u002Fdiv>
  );
}

function CameraFlow({ scenario, goal, startStep, onClose, onDone }) {
  const sc = BG.SCENARIOS[scenario];
  const [step, setStep] = useState(startStep || 'view'); // view → scan → confirm → done
  const [digits, setDigits] = useState(sc.digits.split('').map(Number));
  const flaggedIdx = 4;

  useEffect(() => { setDigits(sc.digits.split('').map(Number)); }, [scenario]);
  useEffect(() => {
    if (step !== 'scan') return;
    const id = setTimeout(() => setStep('confirm'), 1600);
    return () => clearTimeout(id);
  }, [step]);

  const reading = parseInt(digits.join(''), 10);
  const usage = reading - BG.METER_YESTERDAY;
  const valid = usage > 0 && usage < 5000;
  const e = BG.energyOf(Math.max(0, usage));
  const saved = goal - usage;
  const reward = valid ? (saved >= 0 ? 12 : 2) : 0;
  const savedEnergy = Math.abs(saved) * BG.PER_LITER_KWH;

  const darkTop = (title) => (
    <div style={{ display: 'flex', alignItems: 'center', padding: '6px 12px' }}>
      <button className="press" onClick={onClose} style={{ background: 'rgba(255,255,255,0.12)', border: 'none', borderRadius: 12, width: 38, height: 38, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
        <MIcon name="close" size={21} color="#fff"><\u002FMIcon>
      <\u002Fbutton>
      <div className="jua" style={{ flex: 1, textAlign: 'center', fontSize: 17, color: '#fff' }}>{title}<\u002Fdiv>
      <button className="press" style={{ background: 'rgba(255,255,255,0.12)', border: 'none', borderRadius: 12, width: 38, height: 38, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
        <MIcon name="flash_on" size={20} color="#fff" fill={0}><\u002FMIcon>
      <\u002Fbutton>
    <\u002Fdiv>
  );

  // ── 1) 뷰파인더 + 2) 스캔 ──
  if (step === 'view' || step === 'scan') {
    const scanning = step === 'scan';
    return (
      <PhoneFrame bg="#0E1B26" dark>
        <div data-screen-label={scanning ? '촬영-인식중' : '촬영-뷰파인더'} style={{ flex: 1, minHeight: 0, display: 'flex', flexDirection: 'column' }}>
          {darkTop('계량기 촬영')}
          <div style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 18 }}>
            <div style={{ position: 'relative', border: '2.5px dashed rgba(255,255,255,0.45)', borderRadius: 28, padding: 30, overflow: 'hidden' }}>
              <MeterFace digits={sc.digits}><\u002FMeterFace>
              {scanning && <div className="scanline"><\u002Fdiv>}
            <\u002Fdiv>
            {scanning ? (
              <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                <img src="data:image/png;base64," alt="방울이" className="bob" style={{ height: 52 }}><\u002Fimg>
                <div style={{ color: '#fff', fontSize: 14.5, fontWeight: 700 }}>방울이가 숫자를 읽고 있어요…<\u002Fdiv>
              <\u002Fdiv>
            ) : (
              <div style={{ color: 'rgba(255,255,255,0.75)', fontSize: 13.5, fontWeight: 600 }}>숫자판이 테두리 안에 들어오게 맞춰주세요<\u002Fdiv>
            )}
          <\u002Fdiv>
          <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 14, padding: '0 0 22px' }}>
            {!scanning && (
              <button className="press" onClick={() => setStep('manual')} style={{
                background: 'rgba(255,255,255,0.12)', border: '1.5px solid rgba(255,255,255,0.3)', borderRadius: 99,
                padding: '9px 18px', cursor: 'pointer', display: 'flex', alignItems: 'center', gap: 7,
                color: '#fff', fontFamily: 'Jua', fontSize: 14,
              }}>
                <MIcon name="keyboard" size={18} color="#fff"><\u002FMIcon>
                사진 없이 직접 입력하기
              <\u002Fbutton>
            )}
            {!scanning && (
              <div style={{ display: 'flex', alignItems: 'center', gap: 44 }}>
                <button className="press" style={{ background: 'rgba(255,255,255,0.12)', border: 'none', borderRadius: 16, width: 50, height: 50, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
                  <MIcon name="image" size={24} color="#fff" fill={0}><\u002FMIcon>
                <\u002Fbutton>
                <button className="press" onClick={() => setStep('scan')} aria-label="촬영" style={{
                  width: 78, height: 78, borderRadius: '50%', cursor: 'pointer',
                  background: '#fff', border: '5px solid rgba(255,255,255,0.35)', backgroundClip: 'padding-box',
                }}><\u002Fbutton>
                <div style={{ width: 50 }}><\u002Fdiv>
              <\u002Fdiv>
            )}
            <div style={{ display: 'flex', alignItems: 'center', gap: 6, color: 'rgba(255,255,255,0.55)', fontSize: 12 }}>
              <MIcon name="lock" size={14} color="rgba(255,255,255,0.55)"><\u002FMIcon>
              사진은 휴대폰 안에서만 처리되고 밖으로 전송되지 않아요
            <\u002Fdiv>
          <\u002Fdiv>
        <\u002Fdiv>
      <\u002FPhoneFrame>
    );
  }

  // ── 직접 입력 (사진 없이) ──
  if (step === 'manual') {
    return (
      <PhoneFrame>
        <div data-screen-label="검침 숫자 입력하기" className="fade-up" style={{ flex: 1, minHeight: 0, overflowY: 'auto', padding: '0 18px 22px', display: 'flex', flexDirection: 'column' }}>
          <div style={{ display: 'flex', alignItems: 'center', padding: '8px 0' }}>
            <button className="press" onClick={() => setStep('view')} style={{ background: '#fff', border: `1.5px solid ${BGC.line}`, borderRadius: 12, width: 38, height: 38, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
              <MIcon name="arrow_back" size={20} color={BGC.ink}><\u002FMIcon>
            <\u002Fbutton>
            <div className="jua" style={{ flex: 1, textAlign: 'center', fontSize: 18, color: BGC.ink }}>검침 숫자 입력하기<\u002Fdiv>
            <div style={{ width: 38 }}><\u002Fdiv>
          <\u002Fdiv>

          <div style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center', paddingBottom: 20 }}>
          <Card style={{ marginTop: 0 }}>
            <SectionLabel icon="tune">검침 숫자를 입력하세요<\u002FSectionLabel>
            <div style={{ display: 'flex', justifyContent: 'center', gap: 6 }}>
              {digits.map((d, i) => (
                <React.Fragment key={i}>
                  {i === 4 && <div className="jua" style={{ alignSelf: 'center', fontSize: 22, color: BGC.sub }}>.<\u002Fdiv>}
                  <DialCol val={d} red={i >= 4} flagged={false} onChange={(v) => setDigits(digits.map((x, j) => (j === i ? v : x)))}><\u002FDialCol>
                <\u002FReact.Fragment>
              ))}
            <\u002Fdiv>
            <div style={{
              marginTop: 14, borderRadius: 14, padding: '12px 14px', textAlign: 'center',
              background: valid ? '#EAF5FD' : '#FBEAE8',
            }}>
              {valid ? (
                <span style={{ fontSize: 14, fontWeight: 700, color: BGC.ink }}>
                  오늘 사용량 <span className="jua" style={{ fontSize: 19, color: BGC.skyDeep }}>{usage.toLocaleString()}L<\u002Fspan>
                  <span style={{ color: BGC.sub }}> = 오늘 검침 − 어제 검침<\u002Fspan>
                <\u002Fspan>
              ) : (
                <span style={{ fontSize: 13.5, fontWeight: 700, color: BGC.red }}>어제 검침값보다 작아요 — 숫자를 다시 확인해 주세요<\u002Fspan>
              )}
            <\u002Fdiv>
          <\u002FCard>

          <PrimaryBtn icon="check" onClick={() => valid && setStep('done')} disabled={!valid} style={{ marginTop: 14 }}>이 값으로 확정<\u002FPrimaryBtn>
          <\u002Fdiv>
        <\u002Fdiv>
      <\u002FPhoneFrame>
    );
  }

  // ── 3) 다이얼 보정 ──
  if (step === 'confirm') {
    return (
      <PhoneFrame>
        <div data-screen-label="OCR 다이얼 보정" className="fade-up" style={{ flex: 1, minHeight: 0, overflowY: 'auto', padding: '0 18px 22px' }}>
          <div style={{ display: 'flex', alignItems: 'center', padding: '8px 0' }}>
            <button className="press" onClick={() => setStep('view')} style={{ background: '#fff', border: `1.5px solid ${BGC.line}`, borderRadius: 12, width: 38, height: 38, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer' }}>
              <MIcon name="arrow_back" size={20} color={BGC.ink}><\u002FMIcon>
            <\u002Fbutton>
            <div className="jua" style={{ flex: 1, textAlign: 'center', fontSize: 18, color: BGC.ink }}>인식 결과 확인<\u002Fdiv>
            <div style={{ width: 38 }}><\u002Fdiv>
          <\u002Fdiv>

          <div style={{ display: 'flex', justifyContent: 'center', gap: 8, marginBottom: 14 }}>
            <Chip icon="document_scanner" color={BGC.skyDeep}>OCR 신뢰도 91%<\u002FChip>
            <Chip icon="touch_app" color="#C26A1B" bg="#FDEFD9">노란 칸만 확인해 주세요<\u002FChip>
          <\u002Fdiv>

          <Card pad={16} style={{ display: 'flex', alignItems: 'center', gap: 14, background: '#1B2F44', border: 'none' }}>
            <MeterFace digits={digits.join('')} scale={0.52}><\u002FMeterFace>
            <div style={{ color: '#fff' }}>
              <div style={{ fontSize: 12, opacity: 0.65, fontWeight: 700 }}>방금 찍은 계량기<\u002Fdiv>
              <div className="jua" style={{ fontSize: 21, marginTop: 4 }}>
                {digits.slice(0, 4).join('')}<span style={{ color: '#FF9C92' }}>.{digits.slice(4).join('')}<\u002Fspan> ㎥
              <\u002Fdiv>
              <div style={{ fontSize: 11.5, opacity: 0.65, marginTop: 4 }}>어제 검침 0234.412 ㎥<\u002Fdiv>
            <\u002Fdiv>
          <\u002FCard>

          <Card style={{ marginTop: 12 }}>
            <SectionLabel icon="tune">다이얼로 맞춰주세요<\u002FSectionLabel>
            <div style={{ display: 'flex', justifyContent: 'center', gap: 6 }}>
              {digits.map((d, i) => (
                <React.Fragment key={i}>
                  {i === 4 && <div className="jua" style={{ alignSelf: 'center', fontSize: 22, color: BGC.sub }}>.<\u002Fdiv>}
                  <DialCol val={d} red={i >= 4} flagged={i === flaggedIdx} onChange={(v) => setDigits(digits.map((x, j) => (j === i ? v : x)))}><\u002FDialCol>
                <\u002FReact.Fragment>
              ))}
            <\u002Fdiv>
            <div style={{
              marginTop: 14, borderRadius: 14, padding: '12px 14px', textAlign: 'center',
              background: valid ? '#EAF5FD' : '#FBEAE8',
            }}>
              {valid ? (
                <span style={{ fontSize: 14, fontWeight: 700, color: BGC.ink }}>
                  오늘 사용량 <span className="jua" style={{ fontSize: 19, color: BGC.skyDeep }}>{usage.toLocaleString()}L<\u002Fspan>
                  <span style={{ color: BGC.sub }}> = 오늘 검침 − 어제 검침<\u002Fspan>
                <\u002Fspan>
              ) : (
                <span style={{ fontSize: 13.5, fontWeight: 700, color: BGC.red }}>어제 검침값보다 작아요 — 숫자를 다시 확인해 주세요<\u002Fspan>
              )}
            <\u002Fdiv>
          <\u002FCard>

          <div style={{ display: 'flex', gap: 10, marginTop: 14 }}>
            <GhostBtn icon="photo_camera" onClick={() => setStep('view')} style={{ flex: 1 }}>다시 찍기<\u002FGhostBtn>
            <PrimaryBtn icon="check" onClick={() => valid && setStep('done')} disabled={!valid} style={{ flex: 1.4 }}>이 값으로 확정<\u002FPrimaryBtn>
          <\u002Fdiv>
          <div style={{ display: 'flex', justifyContent: 'center', gap: 6, marginTop: 12, color: BGC.sub, fontSize: 11.5 }}>
            <MIcon name="school" size={14} color={BGC.sub}><\u002FMIcon>
            수정한 값은 인식 모델 학습에 활용돼 점점 똑똑해져요
          <\u002Fdiv>
        <\u002Fdiv>
      <\u002FPhoneFrame>
    );
  }

  // ── 4) 기록 완료 ──
  return (
    <PhoneFrame bg="#EAF5FD">
      <div data-screen-label="기록 완료" className="fade-up" style={{ flex: 1, minHeight: 0, overflowY: 'auto', padding: '10px 20px 24px', display: 'flex', flexDirection: 'column' }}>
        <div style={{ textAlign: 'center', marginTop: 6 }}>
          <div className="pop" style={{ display: 'inline-flex', alignItems: 'center', gap: 8, background: '#FFF6D8', border: '1.5px solid #F3DF9B', borderRadius: 99, padding: '8px 18px' }}>
            <img src="data:image/png;base64," alt="나무코인" style={{ width: 26, height: 26 }}><\u002Fimg>
            <span className="jua" style={{ fontSize: 18, color: '#8A6A14' }}>나무코인 +{reward}<\u002Fspan>
          <\u002Fdiv>
          <div className="jua" style={{ fontSize: 28, color: BGC.ink, marginTop: 14 }}>오늘 기록 완료!<\u002Fdiv>
          <img src={saved >= 0 ? 'data:image/png;base64,' : 'data:image/png;base64,'} alt="방울이" className="bob" style={{ height: 130, marginTop: 10 }}><\u002Fimg>
        <\u002Fdiv>

        <Card style={{ marginTop: 12 }}>
          <div style={{ display: 'flex', alignItems: 'baseline', gap: 6 }}>
            <span className="jua" style={{ fontSize: 34, color: BGC.skyDeep }}>{usage.toLocaleString()}L<\u002Fspan>
            <span style={{ fontSize: 13, fontWeight: 700, color: BGC.sub }}>/ 목표 {goal}L<\u002Fspan>
            <div style={{ flex: 1 }}><\u002Fdiv>
            {saved >= 0
              ? <Chip icon="check_circle" color="#2C8A60" bg="#E8F6EF">{saved}L 절약<\u002FChip>
              : <Chip icon="error" color="#C26A1B" bg="#FDEFD9">{-saved}L 초과<\u002FChip>}
          <\u002Fdiv>
          <div style={{ margin: '10px 0 14px' }}>
            <WaterBar value={usage} goal={goal}><\u002FWaterBar>
          <\u002Fdiv>
          {[['local_fire_department', '#C26A1B', '온수 가열', e.hot], ['water_drop', BGC.skyDeep, '상수도 공급', e.supply], ['waves', '#2C8A60', '하수 처리', e.sewage]].map(([ic, c, label, v]) => (
            <div key={label} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '5px 0', fontSize: 13.5, color: BGC.ink, fontWeight: 600 }}>
              <MIcon name={ic} size={17} color={c}><\u002FMIcon>
              <span style={{ flex: 1 }}>{label}<\u002Fspan>
              <span className="jua" style={{ fontSize: 15 }}>{BG.fmt1(v)} kWh<\u002Fspan>
            <\u002Fdiv>
          ))}
          <div style={{ borderTop: `1.5px dashed ${BGC.line}`, marginTop: 6, paddingTop: 10, display: 'flex', gap: 7 }}>
            <Chip icon="bolt" color="#B8860B" bg="#FFF6D8">총 {BG.fmt1(e.total)}kWh<\u002FChip>
            <Chip icon="co2" color="#2C8A60" bg="#E8F6EF">CO₂ {BG.fmt1(e.co2)}kg<\u002FChip>
          <\u002Fdiv>
        <\u002FCard>

        <div style={{ marginTop: 12, background: '#FFF6D8', border: '1.5px solid #F3DF9B', borderRadius: 18, padding: '13px 16px', fontSize: 13.5, lineHeight: 1.55, color: '#6B5410', fontWeight: 600 }}>
          {saved >= 0
            ? <span>물 {saved}L를 아낀 만큼 <b>온수 데우는 에너지 약 {BG.fmt1(savedEnergy)}kWh<\u002Fb>도 함께 절약했어요!<\u002Fspan>
            : <span>내일은 온수 샤워를 1분만 줄여볼까요? 물 12L와 에너지 0.74kWh를 같이 아낄 수 있어요!<\u002Fspan>}
        <\u002Fdiv>

        <div style={{ flex: 1 }}><\u002Fdiv>
        <PrimaryBtn icon="home" onClick={() => onDone({ usage, reward })} style={{ marginTop: 14 }}>방울이에게 가기<\u002FPrimaryBtn>
      <\u002Fdiv>
    <\u002FPhoneFrame>
  );
}

Object.assign(window, { CameraFlow, MeterFace });

<\u002Fscript>
<script type="text/babel">
// 방울이 — 물 가계부 + 에너지 리포트
const { useState } = React;

function monthEntries(usage, recorded) {
  const now = new Date();
  const list = BG.HISTORY.filter((h) => h.date.getMonth() === now.getMonth() && h.date.getFullYear() === now.getFullYear());
  if (recorded) list.push({ date: now, liters: usage, recorded: true, isToday: true });
  return list;
}

function LedgerScreen({ usage, recorded, goal, onNav, unit, tariff }) {
  const [mode, setMode] = useState('주간');
  const fmtV = (liters) => (unit === '원' ? '₩' + Math.round(liters * (tariff || 1)).toLocaleString() : liters.toLocaleString() + 'L');
  const now = new Date();
  const week = BG.HISTORY.slice(-6).concat([{ date: now, liters: recorded ? usage : 0, recorded, isToday: true }]);
  const maxL = Math.max(goal, ...week.map((w) => w.liters)) * 1.12;
  const month = monthEntries(usage, recorded);
  const mRec = month.filter((m) => m.recorded);
  const mTotal = mRec.reduce((s, m) => s + m.liters, 0);
  const mHit = mRec.filter((m) => m.liters <= goal).length;

  const rowChip = (h) => {
    if (!h.recorded) return <Chip color="#93A9BA" bg="#EFF4F8">미기록<\u002FChip>;
    const d = goal - h.liters;
    return d >= 0
      ? <Chip icon="check_circle" color="#2C8A60" bg="#E8F6EF">-{d}L 절약<\u002FChip>
      : <Chip icon="error" color="#C26A1B" bg="#FDEFD9">+{-d}L 초과<\u002FChip>;
  };

  return (
    <div data-screen-label="물 가계부" className="fade-up" style={{ padding: '0 18px 100px' }}>
      <ScreenHead title="물 가계부" sub="계량기 실측으로 기록된 우리집 물 사용"><\u002FScreenHead>
      <div style={{ margin: '10px 0 14px' }}>
        <Segmented options={['주간', '월간']} value={mode} onChange={setMode}><\u002FSegmented>
      <\u002Fdiv>

      {mode === '주간' ? (
        <React.Fragment>
          <Card>
            <SectionLabel icon="bar_chart" right={<Chip color={BGC.skyDeep}>목표 {goal}L<\u002FChip>}>최근 7일<\u002FSectionLabel>
            <div style={{ position: 'relative', height: 168, marginTop: 6 }}>
              <div style={{ position: 'absolute', left: 0, right: 0, bottom: 26 + (goal / maxL) * 130, borderTop: '2px dashed #AFD4EE' }}><\u002Fdiv>
              <div style={{ position: 'absolute', inset: 0, display: 'flex', alignItems: 'flex-end', gap: 8 }}>
                {week.map((w, i) => {
                  const h = w.recorded ? Math.max(10, (w.liters / maxL) * 130) : 8;
                  const today = !!w.isToday;
                  const over = w.liters > goal;
                  return (
                    <div key={i} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4 }}>
                      <span className="jua" style={{ fontSize: 11, color: w.recorded ? (over ? '#C26A1B' : BGC.skyDeep) : '#A9C0D2' }}>
                        {w.recorded ? w.liters : '–'}
                      <\u002Fspan>
                      <div style={{
                        width: '74%', height: h, borderRadius: '8px 8px 4px 4px',
                        background: !w.recorded ? '#E4EEF6'
                          : today ? 'linear-gradient(180deg,#6FD6AE,#2C8A60)'
                          : over ? 'linear-gradient(180deg,#FFC46B,#F5894F)'
                          : 'linear-gradient(180deg,#7BCBFF,#2E86C9)',
                        border: today ? '1.5px solid #1F7A52' : 'none',
                      }}><\u002Fdiv>
                      <span style={{ fontSize: 10.5, fontWeight: today ? 800 : 600, color: today ? BGC.ink : BGC.sub }}>
                        {today ? '오늘' : BG.dayName(w.date)}
                      <\u002Fspan>
                    <\u002Fdiv>
                  );
                })}
              <\u002Fdiv>
            <\u002Fdiv>
          <\u002FCard>

          <Card style={{ marginTop: 12 }} pad={10}>
            {[...week].reverse().map((h, i) => (
              <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 12, padding: '9px 8px', borderBottom: i < week.length - 1 ? `1px solid #EDF5FB` : 'none' }}>
                <div style={{
                  width: 38, height: 38, borderRadius: '50%', flexShrink: 0,
                  background: h.recorded ? '#EAF5FD' : '#F1F5F8',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                }}>
                  <MIcon name={h.recorded ? 'water_drop' : 'close'} size={19} color={h.recorded ? BGC.skyDeep : '#A9C0D2'}><\u002FMIcon>
                <\u002Fdiv>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 14, fontWeight: 800, color: BGC.ink }}>
                    {h.isToday ? '오늘' : `${BG.fmtDate(h.date)} (${BG.dayName(h.date)})`}
                  <\u002Fdiv>
                  <div style={{ fontSize: 11.5, color: BGC.sub, marginTop: 1 }}>
                    {h.recorded ? `에너지 ${BG.fmt1(BG.energyOf(h.liters).total)}kWh · CO₂ ${BG.fmt1(BG.energyOf(h.liters).co2)}kg` : h.isToday ? '계량기를 찍어주세요' : '기록이 없어요'}
                  <\u002Fdiv>
                <\u002Fdiv>
                {h.recorded && <span className="jua" style={{ fontSize: 17, color: BGC.ink }}>{fmtV(h.liters)}<\u002Fspan>}
                {h.isToday && !h.recorded
                  ? <PrimaryBtn icon="photo_camera" onClick={() => onNav('camera')} style={{ width: 'auto', minHeight: 36, padding: '0 12px', fontSize: 13 }}>기록<\u002FPrimaryBtn>
                  : rowChip(h)}
              <\u002Fdiv>
            ))}
          <\u002FCard>
        <\u002FReact.Fragment>
      ) : (
        <React.Fragment>
          <Card>
            <SectionLabel icon="calendar_month">{now.getMonth() + 1}월 사용 요약<\u002FSectionLabel>
            <div style={{ display: 'flex', textAlign: 'center' }}>
              {[['누적 사용', unit === '원' ? fmtV(mTotal) : (mTotal / 1000).toFixed(2) + '㎥'], ['목표 달성', mHit + '일'], ['하루 평균', fmtV(Math.round(mTotal / Math.max(1, mRec.length)))]].map(([k, v]) => (
                <div key={k} style={{ flex: 1 }}>
                  <div className="jua" style={{ fontSize: 22, color: BGC.skyDeep }}>{v}<\u002Fdiv>
                  <div style={{ fontSize: 11.5, fontWeight: 700, color: BGC.sub, marginTop: 2 }}>{k}<\u002Fdiv>
                <\u002Fdiv>
              ))}
            <\u002Fdiv>
          <\u002FCard>

          <Card style={{ marginTop: 12 }}>
            <SectionLabel icon="grid_view">날짜별 현황<\u002FSectionLabel>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: 6 }}>
              {month.map((m, i) => {
                const ok = m.recorded && m.liters <= goal;
                const over = m.recorded && m.liters > goal;
                return (
                  <div key={i} style={{
                    aspectRatio: '1', borderRadius: 10,
                    background: ok ? '#CDE9FD' : over ? '#FDE3C8' : '#EFF4F8',
                    border: m.isToday ? `2px solid ${BGC.skyDeep}` : 'none',
                    display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',
                  }}>
                    <span style={{ fontSize: 11, fontWeight: 800, color: ok ? BGC.skyDeep : over ? '#C26A1B' : '#A9C0D2' }}>{m.date.getDate()}<\u002Fspan>
                  <\u002Fdiv>
                );
              })}
            <\u002Fdiv>
            <div style={{ display: 'flex', gap: 7, marginTop: 12 }}>
              <Chip color={BGC.skyDeep}>달성<\u002FChip>
              <Chip color="#C26A1B" bg="#FDEFD9">초과<\u002FChip>
              <Chip color="#93A9BA" bg="#EFF4F8">미기록<\u002FChip>
            <\u002Fdiv>
          <\u002FCard>
        <\u002FReact.Fragment>
      )}
    <\u002Fdiv>
  );
}

function ReportScreen({ usage, recorded, goal }) {
  const now = new Date();
  const PERIODS = { '주간': 7, '월간': 30, '연간': 365 };
  const [period, setPeriod] = useState('월간');
  const fmtD = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const _defFrom = new Date(now); _defFrom.setDate(_defFrom.getDate() - 30);
  const [from, setFrom] = useState(fmtD(_defFrom));
  const [to, setTo] = useState(fmtD(now));
  const isCustom = period === '날짜지정';
  let winStart, winEnd, prevStart, prevEnd;
  if (isCustom) {
    winStart = new Date(from + 'T00:00:00');
    winEnd = new Date(to + 'T23:59:59');
    const span = Math.max(86400000, winEnd - winStart);
    prevEnd = new Date(winStart);
    prevStart = new Date(winStart.getTime() - span);
  } else {
    const days = PERIODS[period] || 30;
    winEnd = now;
    winStart = new Date(now); winStart.setDate(winStart.getDate() - days);
    prevEnd = winStart;
    prevStart = new Date(now); prevStart.setDate(prevStart.getDate() - days * 2);
  }
  const periodLabel = isCustom ? `${from} ~ ${to}` : period;
  const all = recorded ? [...BG.HISTORY, { date: now, liters: usage, recorded: true }] : [...BG.HISTORY];
  const inWin = all.filter((h) => h.recorded && h.date >= winStart && h.date <= winEnd);
  const inPrev = all.filter((h) => h.recorded && h.date >= prevStart && h.date < prevEnd);
  const mTotal = inWin.reduce((s, h) => s + h.liters, 0);
  const e = BG.energyOf(mTotal);
  const curAvg = Math.round(mTotal / Math.max(1, inWin.length));
  const prevAvg = Math.round(inPrev.reduce((s, h) => s + h.liters, 0) / Math.max(1, inPrev.length));
  const diffPct = prevAvg ? Math.round(((prevAvg - curAvg) / prevAvg) * 1000) / 10 : 0;
  const pines = Math.max(1, Math.round(e.co2 / 8.8)); // 소나무 1그루 연간 흡수 ≈ 8.8kg

  const row = (ic, c, label, sub, v) => (
    <div key={label} style={{ display: 'flex', alignItems: 'center', gap: 11, padding: '9px 0' }}>
      <div style={{ width: 40, height: 40, borderRadius: 13, background: '#F4FAFE', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
        <MIcon name={ic} size={21} color={c}><\u002FMIcon>
      <\u002Fdiv>
      <div style={{ flex: 1 }}>
        <div style={{ fontSize: 14, fontWeight: 800, color: BGC.ink }}>{label}<\u002Fdiv>
        <div style={{ fontSize: 11.5, color: BGC.sub }}>{sub}<\u002Fdiv>
      <\u002Fdiv>
      <span className="jua" style={{ fontSize: 17, color: BGC.ink }}>{BG.fmt1(v)} kWh<\u002Fspan>
    <\u002Fdiv>
  );

  return (
    <div data-screen-label="에너지 리포트" className="fade-up" style={{ padding: '0 18px 100px' }}>
      <ScreenHead title="에너지 리포트" sub="기간을 선택해 물 사용을 에너지·탄소로 환산해 봐요"><\u002FScreenHead>

      <div style={{ margin: '10px 0 2px' }}>
        <Segmented options={['주간', '월간', '연간', '날짜지정']} value={period} onChange={setPeriod}><\u002FSegmented>
      <\u002Fdiv>
      {isCustom && (
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, margin: '8px 2px 0' }}>
          <input type="date" value={from} max={to} onChange={(ev) => setFrom(ev.target.value)} style={{ flex: 1, minWidth: 0, textAlign: 'center', padding: '9px 10px', borderRadius: 12, border: `1.5px solid ${BGC.line}`, fontFamily: 'inherit', fontSize: 13, fontWeight: 700, color: BGC.ink, background: '#fff' }}><\u002Finput>
          <span style={{ color: BGC.sub, fontWeight: 800 }}>~<\u002Fspan>
          <input type="date" value={to} min={from} onChange={(ev) => setTo(ev.target.value)} style={{ flex: 1, minWidth: 0, textAlign: 'center', padding: '9px 10px', borderRadius: 12, border: `1.5px solid ${BGC.line}`, fontFamily: 'inherit', fontSize: 13, fontWeight: 700, color: BGC.ink, background: '#fff' }}><\u002Finput>
        <\u002Fdiv>
      )}

      <div style={{
        marginTop: 10, borderRadius: 24, padding: '20px 20px 18px', color: '#fff',
        background: 'linear-gradient(135deg, #4FB1F0, #2E86C9)', boxShadow: '0 8px 22px rgba(46,134,201,0.35)',
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 13, fontWeight: 700, opacity: 0.9 }}>
          <MIcon name="water_drop" size={17} color="#fff"><\u002FMIcon>
          <span style={{ flex: 1, minWidth: 0, textAlign: 'center' }}>{periodLabel} 물 사용 {(mTotal / 1000).toFixed(2)}㎥ ({mTotal.toLocaleString()}L)<\u002Fspan>
        <\u002Fdiv>
        <div style={{ display: 'flex', marginTop: 14, textAlign: 'center' }}>
          <div style={{ flex: 1 }}>
            <div className="jua" style={{ fontSize: 32 }}>{BG.fmt1(e.total)}<span style={{ fontSize: 16 }}> kWh<\u002Fspan><\u002Fdiv>
            <div style={{ fontSize: 12, fontWeight: 700, opacity: 0.85, marginTop: 2 }}>환산 에너지<\u002Fdiv>
          <\u002Fdiv>
          <div style={{ width: 1.5, background: 'rgba(255,255,255,0.35)', margin: '4px 0' }}><\u002Fdiv>
          <div style={{ flex: 1 }}>
            <div className="jua" style={{ fontSize: 32 }}>{BG.fmt1(e.co2)}<span style={{ fontSize: 16 }}> kg<\u002Fspan><\u002Fdiv>
            <div style={{ fontSize: 12, fontWeight: 700, opacity: 0.85, marginTop: 2 }}>CO₂ 배출<\u002Fdiv>
          <\u002Fdiv>
        <\u002Fdiv>
      <\u002Fdiv>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="account_tree">어디에 쓰인 에너지일까요?<\u002FSectionLabel>
        {row('local_fire_department', '#C26A1B', '온수 가열', '물의 45% × 60→15℃ ÷ 효율 0.85', e.hot)}
        {row('water_drop', BGC.skyDeep, '상수도 공급', '취수·정수·가압 0.23 kWh/㎥', e.supply)}
        {row('waves', '#2C8A60', '하수 처리', '0.45 kWh/㎥', e.sewage)}
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="cached">이만큼이에요<\u002FSectionLabel>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
          {[['battery_charging_full', BGC.skyDeep, '#EAF5FD', '스마트폰 충전', `약 ${e.phoneCharges.toLocaleString()}회`], ['park', '#2C8A60', '#E8F6EF', '소나무 CO₂ 흡수', `약 ${pines}그루의 1년치`]].map(([ic, c, b, label, val]) => (
            <div key={ic} style={{ background: b, borderRadius: 16, padding: '13px 16px', display: 'flex', alignItems: 'center', gap: 12 }}>
              <div style={{ width: 38, height: 38, borderRadius: 12, background: '#fff', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                <MIcon name={ic} size={22} color={c}><\u002FMIcon>
              <\u002Fdiv>
              <span style={{ flex: 1, fontSize: 13.5, fontWeight: 700, color: BGC.sub }}>{label}<\u002Fspan>
              <span className="jua" style={{ fontSize: 17, color: BGC.ink }}>{val}<\u002Fspan>
            <\u002Fdiv>
          ))}
        <\u002Fdiv>
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="trending_down" right={diffPct > 0 && <Chip icon="check_circle" color="#2C8A60" bg="#E8F6EF">{diffPct}% 절감<\u002FChip>}>방울이 키우기 전후<\u002FSectionLabel>
        {[['이전 기간 하루 평균', prevAvg, '#C9DFF0'], ['이번 기간 하루 평균', curAvg, 'linear-gradient(90deg,#7BCBFF,#2E86C9)']].map(([k, v, bg]) => (
          <div key={k} style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '5px 0' }}>
            <span style={{ width: 110, fontSize: 12, fontWeight: 700, color: BGC.sub }}>{k}<\u002Fspan>
            <div style={{ flex: 1, height: 16, borderRadius: 99, background: '#EFF6FC', overflow: 'hidden' }}>
              <div style={{ width: (v / Math.max(prevAvg, curAvg)) * 100 + '%', height: '100%', borderRadius: 99, background: bg }}><\u002Fdiv>
            <\u002Fdiv>
            <span className="jua" style={{ fontSize: 14, color: BGC.ink, width: 44, textAlign: 'right' }}>{v}L<\u002Fspan>
          <\u002Fdiv>
        ))}
        <div style={{ fontSize: 12, color: BGC.sub, marginTop: 8, textAlign: 'center' }}>매일 기록한 효과예요 — 방울이가 자랑스러워해요!<\u002Fdiv>
      <\u002FCard>

      <div style={{ fontSize: 10.5, color: '#9FB9CC', lineHeight: 1.6, margin: '14px 4px 0' }}>
        환산 계수 출처: 정수 0.23 kWh/㎥(한국수자원공사) · 하수 0.45 kWh/㎥(한국환경공단) ·
        전력배출계수 0.4173 kg CO₂/kWh(GIR 2023) · 온수 비율 45%(KISTI 실측). 공개통계 기반 추정치로, 추세 파악용이에요.
      <\u002Fdiv>
    <\u002Fdiv>
  );
}

Object.assign(window, { LedgerScreen, ReportScreen });

<\u002Fscript>
<script type="text/babel">
// 방울이 — 상점 (의상 · 방 꾸미기)
const { useState } = React;

const SHOP_ITEMS = {
