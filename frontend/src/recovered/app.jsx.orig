    { id: 'explorer', name: '탐험대 세트', price: 140, sprite: 'img/spr_explorer.png', img: 'img/cos_explorer2.png', faces: { normal: 'img/exp3_normal.png', happy: 'img/exp3_happy.png', wink: 'img/exp3_wink.png', surprised: 'img/exp3_surprised.png', sad: 'img/exp3_sad.png', angry: 'img/exp3_angry.png' }, desc: '탐험모자·멜빵바지·장화에 돋보기까지, 완벽한 탐험 룩.' },
    { id: 'forest', name: '숲속 탐험복 세트', price: 150, sprite: 'img/spr_forest.png', img: 'img/cos_forest.png', faces: { normal: 'img/forest_normal.png', happy: 'img/forest_happy.png', wink: 'img/forest_wink.png', surprised: 'img/forest_surprised.png', sad: 'img/forest_sad.png', angry: 'img/forest_angry.png' }, desc: '초록빛 자연을 담은 숲속 탐험가 스타일.' },
    { id: 'space', name: '우주 탐험복 세트', price: 180, sprite: 'img/spr_space.png', img: 'img/cos_space.png', faces: { normal: 'img/space2_normal.png', happy: 'img/space2_happy.png', wink: 'img/space2_wink.png', surprised: 'img/space2_surprised.png', sad: 'img/space2_sad.png', angry: 'img/space2_angry.png' }, desc: '우주로 떠나는 방울이 우주비행사 슈트.' },
    { id: 'pajama', name: '구름 잠옷 세트', price: 130, sprite: 'img/spr_pajama.png', img: 'img/cos_pajama.png', faces: { normal: 'img/pjf_normal.png', happy: 'img/pjf_happy.png', wink: 'img/pjf_wink.png', surprised: 'img/pjf_surprised.png', sad: 'img/pjf_sad.png', angry: 'img/pjf_angry.png' }, desc: '폭신한 구름무늬 잠옷과 구름 슬리퍼.' },
    { id: 'dress', name: '플라워 가드너 세트', price: 150, sprite: 'img/spr_dress.png', img: 'img/cos_dress.png', faces: { normal: 'img/gard2_normal.png', happy: 'img/gard2_happy.png', wink: 'img/gard2_wink.png', surprised: 'img/gard2_surprised.png', sad: 'img/gard2_sad.png', angry: 'img/gard2_angry.png' }, desc: '밀짚모자에 꽃 한 송이, 물뿌리개까지 든 가드너 룩.' },
    { id: 'wizard', name: '별빛 마법사 세트', price: 200, sprite: 'img/spr_wizard.png', img: 'img/cos_wizard.png', faces: { normal: 'img/wiz_normal.png', happy: 'img/wiz_happy.png', wink: 'img/wiz_wink.png', surprised: 'img/wiz_surprised.png', sad: 'img/wiz_sad.png', angry: 'img/wiz_angry.png' }, desc: '별과 달이 수놓인 신비로운 마법사 로브.' },
    { id: 'winter', name: '포근 겨울 세트', price: 160, sprite: 'img/spr_winter.png', img: 'img/cos_winter.png', faces: { normal: 'img/win_normal.png', happy: 'img/win_happy.png', wink: 'img/win_wink.png', surprised: 'img/win_surprised.png', sad: 'img/win_sad.png', angry: 'img/win_angry.png' }, desc: '눈송이 패딩과 방울방울 목도리로 따뜻하게!' },
  ],
  '방 꾸미기': [
    { id: 'monstera', name: '몬스테라 화분', price: 60, img: 'img/prop_monstera.png', size: 66 },
    { id: 'cactus', name: '선인장 화분', price: 45, img: 'img/prop_cactus.png', size: 56 },
    { id: 'tulip', name: '튜립 화분', price: 55, img: 'img/prop_tulip.png', size: 58 },
    { id: 'floorlamp', name: '플로어 스탠드', price: 85, img: 'img/prop_floorlamp.png', size: 84 },
    { id: 'mintlamp', name: '민트 스탠드등', price: 70, img: 'img/prop_mintlamp.png', size: 82 },
    { id: 'starlamp', name: '별빛 스탠드등', price: 70, img: 'img/prop_starlamp.png', size: 82 },
    { id: 'pinklamp', name: '핑크 무드등', price: 65, img: 'img/prop_pinklamp2.png', size: 62 },
    { id: 'table', name: '원목 테이블', price: 75, img: 'img/prop_table2.png', size: 60 },
    { id: 'stool', name: '민트 스툴', price: 60, img: 'img/prop_stool.png', size: 56 },
    { id: 'basket', name: '별빛 바구니', price: 55, img: 'img/prop_basket.png', size: 54 },
    { id: 'cushion', name: '하트 쿼션', price: 45, img: 'img/prop_cushion.png', size: 52 },
    { id: 'teddy', name: '곰인형', price: 70, img: 'img/prop_teddy.png', size: 60 },
    { id: 'frame', name: '풍경 액자', price: 60, img: 'img/prop_frame.png', size: 58 },
    { id: 'shelf', name: '책 선반', price: 75, img: 'img/prop_shelf.png', size: 62 },
    { id: 'mobile', name: '별빛 모빌', price: 65, img: 'img/prop_mobile.png', size: 70 },
    { id: 'garland', name: '리본 갈랜드', price: 55, img: 'img/prop_garland.png', size: 58 },
    { id: 'dresser', name: '원목 서람장', price: 85, img: 'img/prop_dresser.png', size: 66 },
    { id: 'beanbag', name: '빈백 소파', price: 80, img: 'img/prop_beanbag.png', size: 64 },
    { id: 'ottoman', name: '별빛 오토만', price: 70, img: 'img/prop_ottoman.png', size: 54 },
    { id: 'mirror', name: '전신 거울', price: 80, img: 'img/prop_mirror.png', size: 80 },
    { id: 'books', name: '책 더미', price: 45, img: 'img/prop_books.png', size: 50 },
    { id: 'alarm', name: '알람시계', price: 55, img: 'img/prop_alarm.png', size: 52 },
    { id: 'toybox', name: '장난감 상자', price: 60, img: 'img/prop_toybox.png', size: 56 },
    { id: 'wbasket', name: '빨래 바구니', price: 50, img: 'img/prop_wbasket.png', size: 52 },
  ],
};
const COSTUMES = SHOP_ITEMS['의상'];
const wornImgFor = (id) => (COSTUMES.find((c) => c.id === id) || {}).worn || null;
const spriteFor = (id) => (COSTUMES.find((c) => c.id === id) || {}).sprite || null;
const framesFor = (id) => (COSTUMES.find((c) => c.id === id) || {}).frames || null;
const facesFor = (id) => (COSTUMES.find((c) => c.id === id) || {}).faces || null;

// ── 방 테마 (4종 × 시계/벽지/창문/바닥) ──
// 방 테마 — 하나의 스킨(전체 배경)을 통째로 적용
const ROOM_THEMES = {
  wood: {
    label: '우드 내추럴', price: 60, dots: ['#F0E4CE', '#C99A5E', '#A9C08A'],
    desc: '따뜻한 나무 느낌의 편안한 내추럴 스타일', bg: 'img/theme_wood.png', accent: '#B08850', wall: '#FCE4C6', floor: '#E6A25A',
  },
  green: {
    label: '민트 가든', price: 70, dots: ['#DCE9C8', '#A9CC82', '#6E9E52'],
    desc: '산뜻한 초록빛으로 싱그러운 스타일', bg: 'img/theme_green.png', accent: '#7FA85E', wall: '#E4E7B8', floor: '#DBDEA7',
  },
  night: {
    label: '별빛 밤하늘', price: 80, dots: ['#2C3A63', '#1E2A4C', '#C8A96A'],
    desc: '별과 달빛이 반짝이는 아늑한 밤 스타일', bg: 'img/theme_night.png', accent: '#C8A96A', wall: '#111D37', floor: '#1E2D4E',
  },
  pink: {
    label: '핑크 플라워', price: 90, dots: ['#F7DAD9', '#F0AEB0', '#EBC7A0'],
    desc: '사랑스러운 꽃무늬의 화사한 스타일', bg: 'img/theme_pink.png', accent: '#EC9AA0', wall: '#FEDCCD', floor: '#FCD1C0',
  },
};

// 흰 배경을 가장자리에서 자동으로 투명 처리해주는 이미지 컴포넌트 (런타임 캔버스)
const __cleanCache = {};
function CleanImg({ src, thr = 228, alt = '', style, className }) {
  const [out, setOut] = React.useState(__cleanCache[src] || src);
  React.useEffect(() => {
    if (!src || __cleanCache[src]) { setOut(__cleanCache[src] || src); return; }
    let dead = false;
    const im = new Image();
    im.crossOrigin = 'anonymous';
    im.onload = () => {
      try {
        const w = im.naturalWidth, h = im.naturalHeight;
        const cv = document.createElement('canvas'); cv.width = w; cv.height = h;
        const cx = cv.getContext('2d'); cx.drawImage(im, 0, 0);
        const id = cx.getImageData(0, 0, w, h), d = id.data;
        const near = (i) => d[i] > thr && d[i + 1] > thr && d[i + 2] > thr;
        const seen = new Uint8Array(w * h), st = [];
        for (let x = 0; x < w; x++) { st.push(x); st.push((h - 1) * w + x); }
        for (let y = 0; y < h; y++) { st.push(y * w); st.push(y * w + w - 1); }
        while (st.length) {
          const p = st.pop(); if (p < 0 || p >= w * h || seen[p]) continue; seen[p] = 1;
          const i = p * 4;
          if (d[i + 3] >= 40) { if (!near(i)) continue; d[i + 3] = 0; }
          const x = p % w, y = (p / w) | 0;
          if (x > 0) st.push(p - 1); if (x < w - 1) st.push(p + 1);
          if (y > 0) st.push(p - w); if (y < h - 1) st.push(p + w);
        }
        cx.putImageData(id, 0, 0);
        const url = cv.toDataURL('image/png');
        __cleanCache[src] = url; if (!dead) setOut(url);
      } catch (e) { if (!dead) setOut(src); }
    };
    im.onerror = () => { if (!dead) setOut(src); };
    im.src = src;
    return () => { dead = true; };
  }, [src]);
  return <img src={out} alt={alt} style={style} className={className}><\u002Fimg>;
}

function patCss(pat) {
  if (pat === 'leaf') return { backgroundImage: 'radial-gradient(rgba(120,160,90,0.32) 1.4px, transparent 2px)', backgroundSize: '22px 22px' };
  if (pat === 'star') return { backgroundImage: 'radial-gradient(rgba(232,214,150,0.75) 1px, transparent 1.6px), radial-gradient(rgba(232,214,150,0.4) 1px, transparent 1.6px)', backgroundSize: '26px 26px, 26px 26px', backgroundPosition: '0 0, 13px 13px' };
  if (pat === 'tulip') return { backgroundImage: 'radial-gradient(rgba(230,150,155,0.34) 1.6px, transparent 2.2px)', backgroundSize: '26px 26px' };
  return null;
}

function WallClock({ theme, size = 52, style }) {
  const c = ROOM_THEMES[theme].clock;
  const ticks = [];
  for (let i = 0; i < 12; i++) ticks.push(<div key={i} style={{ position: 'absolute', left: '50%', top: '50%', width: 2, height: 6, background: c.tick, borderRadius: 2, opacity: 0.75, transform: 'translate(-50%,-50%) rotate(' + (i * 30) + 'deg) translateY(-' + (size * 0.33) + 'px)' }}><\u002Fdiv>);
  const petals = [];
  if (c.shape === 'flower') for (let i = 0; i < 10; i++) petals.push(<div key={'p' + i} style={{ position: 'absolute', left: '50%', top: '50%', width: size * 0.34, height: size * 0.34, borderRadius: '50%', background: c.ring, transform: 'translate(-50%,-50%) rotate(' + (i * 36) + 'deg) translateY(-' + (size * 0.4) + 'px)' }}><\u002Fdiv>);
  return (
    <div style={{ position: 'absolute', width: size, height: size, ...style }}>
      {petals}
      <div style={{ position: 'absolute', inset: 0, borderRadius: '50%', background: c.ring, boxShadow: '0 3px 8px rgba(0,0,0,0.22)' }}><\u002Fdiv>
      <div style={{ position: 'absolute', inset: size * 0.11, borderRadius: '50%', background: c.face, overflow: 'hidden' }}>
        {ticks}
        {c.moon && <div style={{ position: 'absolute', right: size * 0.14, bottom: size * 0.16, width: size * 0.28, height: size * 0.28, borderRadius: '50%', boxShadow: 'inset -' + (size * 0.11) + 'px 0 0 ' + c.tick }}><\u002Fdiv>}
        <div style={{ position: 'absolute', left: '50%', top: '50%', width: 2.5, height: size * 0.2, background: c.tick, borderRadius: 2, transformOrigin: 'bottom center', transform: 'translate(-50%,-100%) rotate(-40deg)' }}><\u002Fdiv>
        <div style={{ position: 'absolute', left: '50%', top: '50%', width: 2, height: size * 0.3, background: c.tick, borderRadius: 2, transformOrigin: 'bottom center', transform: 'translate(-50%,-100%) rotate(55deg)' }}><\u002Fdiv>
        <div style={{ position: 'absolute', left: '50%', top: '50%', width: 5, height: 5, borderRadius: '50%', background: c.tick, transform: 'translate(-50%,-50%)' }}><\u002Fdiv>
      <\u002Fdiv>
    <\u002Fdiv>
  );
}

function RoomWindow({ th, w = 98, h = 78, style }) {
  const win = th ? th.win : { frame: '#FBF7EE', glass: 'linear-gradient(180deg,#BFE3FB,#E4F3FD)', arched: false, night: false, curtain: false };
  const topR = win.arched ? Math.round(w / 2) : 12;
  return (
    <div style={{ position: 'absolute', width: w, height: h, ...style }}>
      {win.curtain && <div style={{ position: 'absolute', left: -3, top: -2, bottom: -2, width: 15, borderRadius: 8, background: 'linear-gradient(90deg,#F4C0BB,#FADFDB)', zIndex: 3 }}><\u002Fdiv>}
      {win.curtain && <div style={{ position: 'absolute', right: -3, top: -2, bottom: -2, width: 15, borderRadius: 8, background: 'linear-gradient(90deg,#FADFDB,#F4C0BB)', zIndex: 3 }}><\u002Fdiv>}
      <div style={{ position: 'absolute', inset: 0, borderRadius: topR + 'px ' + topR + 'px 12px 12px', overflow: 'hidden', background: win.glass, border: '5px solid ' + win.frame, boxSizing: 'border-box', boxShadow: '0 3px 8px rgba(46,116,170,0.18)' }}>
        {win.night ? (
          <React.Fragment>
            <div style={{ position: 'absolute', top: 10, left: 12, width: 5, height: 5, borderRadius: '50%', background: '#FBEEB0' }}><\u002Fdiv>
            <div style={{ position: 'absolute', top: 24, left: 40, width: 3, height: 3, borderRadius: '50%', background: '#FBEEB0' }}><\u002Fdiv>
            <div style={{ position: 'absolute', top: 40, left: 22, width: 3, height: 3, borderRadius: '50%', background: '#FBEEB0' }}><\u002Fdiv>
            <div style={{ position: 'absolute', top: 12, right: 14, width: 18, height: 18, borderRadius: '50%', boxShadow: 'inset -7px 0 0 #FBEEB0' }}><\u002Fdiv>
          <\u002FReact.Fragment>
        ) : (
          <React.Fragment>
            <div style={{ position: 'absolute', top: 12, left: 10, width: 34, height: 12, borderRadius: 99, background: 'rgba(255,255,255,0.9)', filter: 'blur(1.5px)' }}><\u002Fdiv>
            <div style={{ position: 'absolute', top: 34, left: 44, width: 26, height: 9, borderRadius: 99, background: 'rgba(255,255,255,0.8)', filter: 'blur(1.5px)' }}><\u002Fdiv>
          <\u002FReact.Fragment>
        )}
        <div style={{ position: 'absolute', left: '50%', top: 0, bottom: 0, width: 4, background: win.frame, transform: 'translateX(-50%)' }}><\u002Fdiv>
        <div style={{ position: 'absolute', top: '50%', left: 0, right: 0, height: 4, background: win.frame, transform: 'translateY(-50%)' }}><\u002Fdiv>
      <\u002Fdiv>
      {th && <div style={{ position: 'absolute', bottom: -6, left: 6, width: 16, height: 14, borderRadius: '3px 3px 5px 5px', background: '#C98A5A' }}><div style={{ position: 'absolute', top: -8, left: '50%', transform: 'translateX(-50%)', width: 14, height: 12, borderRadius: '50%', background: '#7FB56B' }}><\u002Fdiv><\u002Fdiv>}
    <\u002Fdiv>
  );
}

function PartPreview({ theme, slot }) {
  const src = 'img/' + (slot === 'clock' ? 'clock' : slot === 'window' ? 'win' : slot) + '_' + theme + '.png';
  const h = slot === 'wall' || slot === 'floor' ? 60 : 58;
  return <CleanImg src={src} alt="" style={{ height: h, width: 'auto', maxWidth: 78, objectFit: 'contain', filter: 'drop-shadow(0 2px 4px rgba(0,0,0,0.12))' }}><\u002FCleanImg>;
}

function RoomThemeShop({ coins, owned, room, onBuy, onApplyRoom }) {
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>
      {Object.keys(ROOM_THEMES).map((key) => {
        const th = ROOM_THEMES[key];
        const has = owned.includes('theme_' + key);
        const applied = room && room.theme === key;
        const can = coins >= th.price;
        return (
          <div key={key} className="bg-card" style={{ padding: 12, display: 'flex', flexDirection: 'column', gap: 10, border: applied ? '2px solid #6FC59A' : '1.5px solid #E0EFFA' }}>
            <div style={{ position: 'relative', borderRadius: 16, overflow: 'hidden', aspectRatio: '1 / 1', background: '#EAF5FD' }}>
              <img src={th.bg} alt={th.label} style={{ width: '100%', height: '100%', objectFit: 'contain', padding: 8, boxSizing: 'border-box', display: 'block' }}><\u002Fimg>
              {applied && <div style={{ position: 'absolute', top: 8, right: 8 }}><Chip icon="check_circle" color="#2C8A60" bg="rgba(255,255,255,0.92)">적용 중<\u002FChip><\u002Fdiv>}
            <\u002Fdiv>
            <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
              <div style={{ flex: 1 }}>
                <div className="jua" style={{ fontSize: 16, color: BGC.ink }}>{th.label}<\u002Fdiv>
                <div style={{ fontSize: 11.5, color: BGC.sub, marginTop: 2, lineHeight: 1.4 }}>{th.desc}<\u002Fdiv>
              <\u002Fdiv>
              <div style={{ display: 'flex', gap: 5 }}>
                {th.dots.map((c, i) => <div key={i} style={{ width: 16, height: 16, borderRadius: '50%', background: c, border: '1.5px solid rgba(255,255,255,0.8)', boxShadow: '0 1px 3px rgba(0,0,0,0.12)' }}><\u002Fdiv>)}
              <\u002Fdiv>
            <\u002Fdiv>
            {!has ? (
              <button className="press" disabled={!can} onClick={() => onBuy('theme_' + key, th.price)} style={{ width: '100%', minHeight: 40, borderRadius: 12, border: 'none', cursor: can ? 'pointer' : 'default', background: can ? BGC.sky : '#E4EEF6', color: can ? '#fff' : '#A9C0D2', fontFamily: 'Jua', fontSize: 14.5, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6 }}>
                <MIcon name="toll" size={17} color={can ? '#fff' : '#A9C0D2'}><\u002FMIcon>{th.price}{!can && <span style={{ fontSize: 12, fontWeight: 700 }}>· 코인 부족<\u002Fspan>}
              <\u002Fbutton>
            ) : (
              <button className="press" onClick={() => onApplyRoom(key)} style={{ width: '100%', minHeight: 40, borderRadius: 12, cursor: 'pointer', border: applied ? 'none' : '2px solid ' + BGC.line, background: applied ? '#E8F6EF' : '#fff', color: applied ? '#2C8A60' : BGC.sub, fontFamily: 'Jua', fontSize: 14.5, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6 }}>
                {applied && <MIcon name="check" size={16} color="#2C8A60"><\u002FMIcon>}{applied ? '적용 중' : '적용하기'}
              <\u002Fbutton>
            )}
          <\u002Fdiv>
        );
      })}
    <\u002Fdiv>
  );
}

function ShopScreen({ coins, owned, equipped, placed, room, onBuy, onEquip, onPlace, onApplyRoom }) {
  const [tab, setTab] = useState('의상');
  const items = SHOP_ITEMS['방 꾸미기'] || [];
  const isCostume = tab === '의상';
  const isTheme = tab === '방테마';
  const costumes = SHOP_ITEMS['의상'] || [];

  const actionBtn = (it) => {
    const has = owned.includes(it.id);
    if (!has) {
      const can = coins >= it.price;
      return (
        <button className="press" disabled={!can} onClick={() => onBuy(it.id, it.price)} style={{
          width: '100%', minHeight: 38, borderRadius: 12, border: 'none', cursor: can ? 'pointer' : 'default',
          background: can ? BGC.sky : '#E4EEF6', color: can ? '#fff' : '#A9C0D2',
          fontFamily: 'Jua', fontSize: 14.5, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6,
        }}>
          <img src="data:image/png;base64," alt="" style={{ width: 17, height: 17, opacity: can ? 1 : 0.5 }}><\u002Fimg>
          {it.price}{!can && <span style={{ fontSize: 12, fontWeight: 700, marginLeft: 2 }}>· 코인 부족<\u002Fspan>}
        <\u002Fbutton>
      );
    }
    const active = isCostume ? equipped === it.id : placed.includes(it.id);
    const toggle = () => (isCostume ? onEquip(active ? null : it.id) : onPlace(it.id));
    return (
      <button className="press" onClick={toggle} style={{
        width: '100%', minHeight: 38, borderRadius: 12, cursor: 'pointer',
        border: active ? 'none' : `2px solid ${BGC.line}`,
        background: active ? '#E8F6EF' : '#fff', color: active ? '#2C8A60' : BGC.sub,
        fontFamily: 'Jua', fontSize: 14, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 5,
      }}>
        {active && <MIcon name="check" size={16} color="#2C8A60"><\u002FMIcon>}
        {isCostume ? (active ? '착용 중' : '입기') : (active ? '배치됨' : '배치하기')}
      <\u002Fbutton>
    );
  };

  return (
    <div data-screen-label="상점" className="fade-up" style={{ padding: '0 18px 100px' }}>
      <ScreenHead title="방울이 상점" sub="절약으로 모은 나무코인으로 꾸며주세요" right={<CoinChip n={coins}><\u002FCoinChip>}><\u002FScreenHead>

      <div style={{
        marginTop: 10, borderRadius: 20, padding: '12px 16px',
        background: 'linear-gradient(135deg,#FFF6D8,#FFEFC2)', border: '1.5px solid #F3DF9B',
        display: 'flex', alignItems: 'center', gap: 12,
      }}>
        <img src="data:image/png;base64," alt="방울이" style={{ height: 52 }}><\u002Fimg>
        <div style={{ fontSize: 12.5, fontWeight: 700, color: '#6B5410', lineHeight: 1.5, textAlign: 'center' }}>
          목표보다 아껴 쓰면 매일 <b>+12 나무코인<\u002Fb>!<br><\u002Fbr>모은 코인으로 방울이를 꾸며주세요.
        <\u002Fdiv>
      <\u002Fdiv>

      <div style={{ margin: '14px 0' }}>
        <Segmented options={['의상', '방테마', '방 꾸미기']} value={tab} onChange={setTab}><\u002FSegmented>
      <\u002Fdiv>

      {isCostume ? (
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
          {costumes.map((it) => {
            const equippedNow = equipped === it.id;
            return (
              <div key={it.id} className="bg-card" style={{ padding: 12, display: 'flex', flexDirection: 'column', gap: 8, border: equippedNow ? `2px solid #6FC59A` : '1.5px solid #E0EFFA' }}>
                <div style={{ position: 'relative', height: 128, borderRadius: 14, background: 'linear-gradient(180deg,#F4FAFE,#EAF5FD)', display: 'flex', alignItems: 'center', justifyContent: 'center', overflow: 'hidden' }}>
                  <img src={it.img} alt={it.name} style={{ maxHeight: 116, maxWidth: 96, objectFit: 'contain', filter: 'drop-shadow(0 3px 4px rgba(46,116,170,0.15))' }}><\u002Fimg>
                  {equippedNow && <div style={{ position: 'absolute', top: 8, right: 8 }}><Chip icon="check_circle" color="#2C8A60" bg="rgba(255,255,255,0.92)">착용 중<\u002FChip><\u002Fdiv>}
                <\u002Fdiv>
                <div>
                  <div style={{ fontSize: 14.5, fontWeight: 800, color: BGC.ink }}>{it.name}<\u002Fdiv>
                  <div style={{ fontSize: 11, color: BGC.sub, marginTop: 2, lineHeight: 1.4, height: 30, overflow: 'hidden' }}>{it.desc}<\u002Fdiv>
                <\u002Fdiv>
                {actionBtn(it)}
              <\u002Fdiv>
            );
          })}
        <\u002Fdiv>
      ) : isTheme ? (
        <RoomThemeShop coins={coins} owned={owned} room={room} onBuy={onBuy} onApplyRoom={onApplyRoom}><\u002FRoomThemeShop>
      ) : (
        <React.Fragment>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
          {items.map((it) => (
            <div key={it.id} className="bg-card" style={{ padding: 12, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8 }}>
              <div style={{ width: '100%', height: 96, borderRadius: 14, background: 'linear-gradient(180deg,#F4FAFE,#EAF5FD)', display: 'flex', alignItems: 'center', justifyContent: 'center', overflow: 'hidden' }}>
                <img src={it.img} alt={it.name} style={{ maxHeight: 86, maxWidth: '78%', objectFit: 'contain', filter: 'drop-shadow(0 2px 4px rgba(0,0,0,0.12))' }}><\u002Fimg>
              <\u002Fdiv>
              <div style={{ fontSize: 14, fontWeight: 800, color: BGC.ink }}>{it.name}<\u002Fdiv>
              {actionBtn(it)}
            <\u002Fdiv>
          ))}
          <\u002Fdiv>
        <\u002FReact.Fragment>
      )}
    <\u002Fdiv>
  );
}

Object.assign(window, { ShopScreen, SHOP_ITEMS, COSTUMES, wornImgFor, spriteFor, framesFor, ROOM_THEMES });

<\u002Fscript>

<script type="text/babel">
const { useState, useEffect, useRef } = React;

const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
  "scenario": "절약",
  "stage": "자동"
}/*EDITMODE-END*/;

const STORE_KEY = 'banguli_app_v1';
const DEFAULT_STATE = {
  onboarded: false, screen: 'home', house: '4인 이상',
  recorded: false, usage: 0, coins: 9999,
  owned: ['rain', 'monstera'], equipped: null, placed: ['monstera'],
  userName: '우리집', dolphinName: '방울이', fontScale: 1, ledgerUnit: 'L', region: '서울',
  regionSet: false, lastAttend: null, decorPos: {}, pendingEdit: false,
  room: { theme: null },
};
function loadState() {
  try { return { ...DEFAULT_STATE, ...(JSON.parse(localStorage.getItem(STORE_KEY)) || {}) }; }
  catch (e) { return { ...DEFAULT_STATE }; }
}

const REGION_TARIFF = { '서울': 1.0, '부산': 1.3, '대구': 1.2, '인천': 1.0, '광주': 1.1, '대전': 1.0, '울산': 1.2, '세종': 1.0, '경기': 1.1, '강원': 1.2, '충북': 1.1, '충남': 1.1, '전주': 1.1, '여수': 1.1, '포항': 1.2, '창원': 1.2, '제주': 1.3 }; // 원/L (상하수도 합산 근사)

function SettingsScreen({ st, patch, regions }) {
  const set = (k, v) => patch({ [k]: v });
  const inputStyle = { width: '100%', boxSizing: 'border-box', marginTop: 6, padding: '11px 13px', borderRadius: 12, border: `1.5px solid ${BGC.line}`, fontFamily: 'inherit', fontSize: 15, fontWeight: 700, color: BGC.ink, background: '#fff' };
  const labelStyle = { fontSize: 12.5, fontWeight: 800, color: BGC.sub };
  const fsLabel = (st.fontScale || 1) < 1 ? '작게' : (st.fontScale || 1) > 1 ? '크게' : '보통';
  return (
    <div data-screen-label="설정" className="fade-up" style={{ padding: '0 18px 100px' }}>
      <ScreenHead title="설정" sub="앱을 내 취향대로 맞춰보세요"><\u002FScreenHead>

      <Card style={{ marginTop: 10 }}>
        <SectionLabel icon="badge">이름<\u002FSectionLabel>
        <div style={labelStyle}>사용자 이름<\u002Fdiv>
        <input value={st.userName || ''} onChange={(ev) => set('userName', ev.target.value)} placeholder="우리집" style={inputStyle}><\u002Finput>
        <div style={{ ...labelStyle, marginTop: 12 }}>방울이 이름<\u002Fdiv>
        <input value={st.dolphinName || ''} onChange={(ev) => set('dolphinName', ev.target.value)} placeholder="방울이" style={inputStyle}><\u002Finput>
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="text_fields">글자 크기<\u002FSectionLabel>
        <Segmented options={['작게', '보통', '크게']} value={fsLabel} onChange={(v) => set('fontScale', v === '작게' ? 0.9 : v === '크게' ? 1.05 : 1)}><\u002FSegmented>
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="receipt_long">가계부 표시 단위<\u002FSectionLabel>
        <Segmented options={['리터 (L)', '금액 (원)']} value={st.ledgerUnit === '원' ? '금액 (원)' : '리터 (L)'} onChange={(v) => set('ledgerUnit', v === '금액 (원)' ? '원' : 'L')}><\u002FSegmented>
        <div style={{ fontSize: 12, color: BGC.sub, marginTop: 8 }}>금액은 선택한 지역 요금 기준 추정치예요.<\u002Fdiv>
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="location_on">지역<\u002FSectionLabel>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8 }}>
          {regions.map((r) => {
            const on = (st.region || '서울') === r;
            return (
              <button key={r} className="press" onClick={() => set('region', r)} style={{
                padding: '9px 16px', borderRadius: 99, cursor: 'pointer', fontFamily: 'Jua', fontSize: 14,
                border: on ? 'none' : `1.5px solid ${BGC.line}`,
                background: on ? BGC.sky : '#fff', color: on ? '#fff' : BGC.sub,
              }}>{r}<\u002Fbutton>
            );
          })}
        <\u002Fdiv>
      <\u002FCard>

      <Card style={{ marginTop: 12 }}>
        <SectionLabel icon="replay">처음부터<\u002FSectionLabel>
        <button className="press" onClick={() => { if (window.__replayOnboarding) window.__replayOnboarding(); }} style={{
          width: '100%', boxSizing: 'border-box', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8,
          marginTop: 4, padding: '12px 14px', borderRadius: 12, cursor: 'pointer',
          border: `1.5px solid ${BGC.line}`, background: '#fff', color: BGC.sky, fontFamily: 'Jua', fontSize: 15,
        }}>
          <MIcon name="replay" size={18} color={BGC.sky}><\u002FMIcon>
          처음부터 보기
        <\u002Fbutton>
        <div style={{ fontSize: 12, color: BGC.sub, marginTop: 8 }}>온보딩을 다시 보고 앱을 처음 상태로 되돌려요. (보유 코인·아이템은 유지)<\u002Fdiv>
      <\u002FCard>
    <\u002Fdiv>
  );
}

const DECOR_POS = {
  // 벽 (top 110~270)
  garland:   { left: 78,  top: 110 },
  mobile:    { left: 258, top: 116 },
  frame:     { left: 12,  top: 212 },
  shelf:     { left: 250, top: 238 },
  // 바닥 왼쪽
  floorlamp: { left: 4,   top: 292 },
  monstera:  { left: 4,   top: 372 },
  cactus:    { left: 66,  top: 398 },
  tulip:     { left: 10,  top: 438 },
  beanbag:   { left: 40,  top: 446 },
  teddy:     { left: 100, top: 452 },
  starlamp:  { left: 58,  top: 300 },
  // 바닥 오른쪽
  dresser:   { left: 250, top: 366 },
  mintlamp:  { left: 262, top: 300 },
  table:     { left: 250, top: 436 },
  pinklamp:  { left: 292, top: 398 },
  stool:     { left: 206, top: 452 },
  ottoman:   { left: 300, top: 456 },
  mirror:    { left: 302, top: 300 },
  wbasket:   { left: 300, top: 414 },
  books:     { left: 214, top: 320 },
  // 중앙 앞
  toybox:    { left: 150, top: 462 },
  basket:    { left: 112, top: 452 },
  cushion:   { left: 176, top: 474 },
  alarm:     { left: 132, top: 320 },
};
const DECOR_MIN_TOP = 108; // 말풍선 아래로만 배치 가능

function DraggableDecor({ id, src, size, initial, roomRef, onEnd }) {
  const [pos, setPos] = useState(initial);
  const [drag, setDrag] = useState(false);
  const start = useRef(null);
  const last = useRef(null);
  useEffect(() => { if (!start.current) setPos(initial); }, [initial.left, initial.top]);
  const clamp = (left, top) => {
    const room = roomRef.current;
    const w = room ? room.clientWidth : 376;
    const h = room ? room.clientHeight : 520;
    const s = size + 6;
    return {
      left: Math.max(4, Math.min(left, w - s)),
      top: Math.max(DECOR_MIN_TOP, Math.min(top, h - s - 42)),
    };
  };
  const onDown = (e) => {
    try { e.currentTarget.setPointerCapture(e.pointerId); } catch (err) {}
    start.current = { px: e.clientX, py: e.clientY, left: pos.left, top: pos.top };
    last.current = pos;
    setDrag(true);
  };
  const onMove = (e) => {
    if (!start.current) return;
    const np = clamp(start.current.left + (e.clientX - start.current.px), start.current.top + (e.clientY - start.current.py));
    last.current = np;
    setPos(np);
  };
  const onUp = () => {
    if (!start.current) return;
    start.current = null;
    setDrag(false);
    if (last.current) onEnd(id, last.current);
  };
  return (
    <div onPointerDown={onDown} onPointerMove={onMove} onPointerUp={onUp} onPointerCancel={onUp}
      style={{ position: 'absolute', left: pos.left, top: pos.top, cursor: drag ? 'grabbing' : 'grab', touchAction: 'none', userSelect: 'none', zIndex: drag ? 30 : 6, transform: drag ? 'scale(1.12)' : 'none', transition: drag ? 'none' : 'transform .15s', filter: 'drop-shadow(0 ' + (drag ? 6 : 3) + 'px ' + (drag ? 9 : 5) + 'px rgba(0,0,0,0.25))' }}>
      <img src={src} alt="" draggable={false} style={{ height: size, width: 'auto', display: 'block', pointerEvents: 'none' }}><\u002Fimg>
    <\u002Fdiv>
  );
}

function ModalOverlay({ children }) {
  return (
    <div style={{ position: 'absolute', inset: 0, zIndex: 60, display: 'flex', alignItems: 'center', justifyContent: 'center', background: 'rgba(20,50,80,0.45)', padding: 20, borderRadius: 26, boxSizing: 'border-box' }}>
      {children}
    <\u002Fdiv>
  );
}

function AttendanceModal({ streak, reward, onClaim }) {
  const days = ['월', '화', '수', '목', '금', '토', '일'];
  const todayIdx = (new Date().getDay() + 6) % 7;
  return (
    <ModalOverlay>
      <div className="fade-up" style={{ width: 320, background: '#fff', borderRadius: 24, padding: '22px 20px', textAlign: 'center', boxShadow: '0 20px 50px rgba(21,58,86,0.35)', boxSizing: 'border-box' }}>
        <div style={{ fontSize: 40 }}>💧<\u002Fdiv>
        <div className="jua" style={{ fontSize: 21, color: BGC.ink, marginTop: 4 }}>오늘도 출석 완료!<\u002Fdiv>
        <div style={{ fontSize: 13, color: BGC.sub, marginTop: 6 }}>연속 <b style={{ color: BGC.skyDeep }}>{streak}일<\u002Fb>째 방울이를 돌봐주고 있어요<\u002Fdiv>
        <div style={{ display: 'flex', justifyContent: 'space-between', gap: 6, margin: '18px 0' }}>
          {days.map((d, i) => {
            const on = i <= todayIdx;
            const today = i === todayIdx;
            return (
              <div key={d} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4 }}>
                <div style={{ fontSize: 11, fontWeight: 800, color: today ? BGC.skyDeep : BGC.sub }}>{d}<\u002Fdiv>
                <div style={{ width: 30, height: 30, borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 15, background: on ? (today ? BGC.sky : '#D6EEFB') : '#EEF4F8', border: today ? `2px solid ${BGC.skyDeep}` : 'none', boxSizing: 'border-box' }}>{on ? '💧' : ''}<\u002Fdiv>
              <\u002Fdiv>
            );
          })}
        <\u002Fdiv>
        <div style={{ background: '#FFF6D8', border: '1.5px solid #F3DF9B', borderRadius: 14, padding: '10px', fontSize: 14, fontWeight: 800, color: '#8A6A14' }}>출석 보상 +{reward} 나무코인<\u002Fdiv>
        <PrimaryBtn icon="redeem" onClick={onClaim} style={{ marginTop: 14 }}>코인 받기<\u002FPrimaryBtn>
      <\u002Fdiv>
    <\u002FModalOverlay>
  );
}

function RegionModal({ regions, onSelect }) {
  const [sel, setSel] = useState(null);
  return (
    <ModalOverlay>
      <div className="fade-up" style={{ width: 340, maxHeight: '82%', overflowY: 'auto', background: '#fff', borderRadius: 24, padding: '22px 20px', boxShadow: '0 20px 50px rgba(21,58,86,0.35)', boxSizing: 'border-box' }}>
        <div style={{ textAlign: 'center' }}>
          <div style={{ fontSize: 36 }}>📍<\u002Fdiv>
          <div className="jua" style={{ fontSize: 20, color: BGC.ink, marginTop: 4 }}>지역을 선택해 주세요<\u002Fdiv>
          <div style={{ fontSize: 12.5, color: BGC.sub, marginTop: 6, lineHeight: 1.5 }}>지역 요금을 기준으로 물 사용을 금액으로 환산해 드려요. 설정에서 언제든 바꿀 수 있어요.<\u002Fdiv>
        <\u002Fdiv>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, justifyContent: 'center', margin: '18px 0 6px' }}>
          {regions.map((r) => {
            const on = sel === r;
            return (
              <button key={r} className="press" onClick={() => setSel(r)} style={{ padding: '9px 15px', borderRadius: 99, cursor: 'pointer', fontFamily: 'Jua', fontSize: 14, border: on ? 'none' : `1.5px solid ${BGC.line}`, background: on ? BGC.sky : '#fff', color: on ? '#fff' : BGC.sub }}>{r}<\u002Fbutton>
            );
          })}
        <\u002Fdiv>
        <PrimaryBtn icon="check" disabled={!sel} onClick={() => onSelect(sel)} style={{ marginTop: 10 }}>이 지역으로 시작하기<\u002FPrimaryBtn>
      <\u002Fdiv>
    <\u002FModalOverlay>
  );
}

function App() {
  const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
  const [st, setSt] = useState(loadState);
  const [scale, setScale] = useState(1);
  const [showAttend, setShowAttend] = useState(false);
  useEffect(() => {
    const today = new Date().toDateString();
    if (st.regionSet && st.onboarded && st.lastAttend !== today) setShowAttend(true);
  }, []);

  useEffect(() => { localStorage.setItem(STORE_KEY, JSON.stringify(st)); }, [st]);
  useEffect(() => {
    const root = document.getElementById('bgScreen');
    if (!root) return;
    const fs = st.fontScale || 1;
    root.querySelectorAll('*').forEach((el) => {
      if (el.classList.contains('msym')) return; // 아이콘은 제외
      let hasText = false;
      el.childNodes.forEach((n) => { if (n.nodeType === 3 && n.textContent.trim()) hasText = true; });
      if (!hasText) return; // 직접 텍스트가 있는 요소만
      if (el.dataset.basefs === undefined) el.dataset.basefs = parseFloat(getComputedStyle(el).fontSize);
      el.style.fontSize = (parseFloat(el.dataset.basefs) * fs) + 'px';
    });
  });
  useEffect(() => {
    const fit = () => setScale(Math.min(1, (window.innerHeight - 24) / 908, (window.innerWidth - 24) / 424));
    fit();
    window.addEventListener('resize', fit);
    return () => window.removeEventListener('resize', fit);
  }, []);

  const patch = (p) => setSt((s) => ({ ...s, ...p }));
  const nav = (screen) => patch({ screen });
  useEffect(() => {
    window.__replayOnboarding = () => {
      setSt((prev) => {
        const keep = { coins: prev.coins, owned: prev.owned, equipped: prev.equipped };
        const ns = { ...DEFAULT_STATE, ...keep };
        localStorage.setItem(STORE_KEY, JSON.stringify(ns));
        return ns;
      });
    };
    return () => { delete window.__replayOnboarding; };
  }, []);

  const goal = BG.GOAL_BY_HOUSEHOLD[st.house] || 550;
  const scenario = BG.SCENARIOS[t.scenario] ? t.scenario : '절약';
  const usage = st.recorded ? (st.usage || BG.SCENARIOS[scenario].usage) : BG.SCENARIOS[scenario].usage;
  const autoStage = st.recorded ? 1 : 2;
  const stage = t.stage === '자동' ? autoStage : parseInt(t.stage, 10) || autoStage;
  const streak = BG.STREAK + (st.recorded ? 1 : 0);
  const tip = BG.TIPS[new Date().getDate() % BG.TIPS.length];
  const unit = st.ledgerUnit || 'L';
  const tariff = REGION_TARIFF[st.region] || 1.0;

  const allItems = [...SHOP_ITEMS['의상'], ...SHOP_ITEMS['방 꾸미기']];
  const decorOf = (id) => allItems.find((i) => i.id === id);

  let frame;
  if (!st.onboarded) {
    frame = <Onboarding onDone={(house) => patch({ onboarded: true, house, screen: 'home' })}><\u002FOnboarding>;
  } else if (st.screen === 'camera') {
    frame = (
      <CameraFlow scenario={scenario} goal={goal} startStep={st.camStart || 'view'}
        onClose={() => patch({ screen: 'home', camStart: null })}
        onDone={({ usage, reward }) => patch({ recorded: true, usage, coins: st.coins + reward, screen: 'home', camStart: null })}>
      <\u002FCameraFlow>
    );
  } else {
    const app = {
      stage, recorded: st.recorded, usage, goal, coins: st.coins, streak, tip,
      house: st.house, userName: st.userName, dolphinName: st.dolphinName, onNav: nav, onManual: () => patch({ screen: 'camera', camStart: 'confirm' }),
      wornImg: wornImgFor(st.equipped), sprite: spriteFor(st.equipped), frames: framesFor(st.equipped), faces: facesFor(st.equipped),
      owned: st.owned, equipped: st.equipped, onEquip: (id) => patch({ equipped: id }),
      placedItems: st.placed.map((id) => { const it = decorOf(id); return it && it.img ? { id, img: it.img, size: it.size || 56 } : null; }).filter(Boolean),
      decorPos: st.decorPos || {},
      room: st.room || {},
      startEdit: st.pendingEdit,
      clearStartEdit: () => setSt((s) => ({ ...s, pendingEdit: false })),
      onMoveDecor: (id, pos) => setSt((s) => ({ ...s, decorPos: { ...(s.decorPos || {}), [id]: pos } })),
    };
    const screens = {
      home: <HomeScreen app={app}><\u002FHomeScreen>,
      ledger: <LedgerScreen usage={usage} recorded={st.recorded} goal={goal} onNav={nav} unit={unit} tariff={tariff}><\u002FLedgerScreen>,
      report: <ReportScreen usage={usage} recorded={st.recorded} goal={goal}><\u002FReportScreen>,
      settings: <SettingsScreen st={st} patch={patch} regions={Object.keys(REGION_TARIFF)}><\u002FSettingsScreen>,
      shop: (
        <ShopScreen coins={st.coins} owned={st.owned} equipped={st.equipped} placed={st.placed}
          onBuy={(id, price) => patch({ coins: st.coins - price, owned: [...st.owned, id] })}
          onEquip={(id) => patch({ equipped: id })}
          onApplyRoom={(theme) => setSt((s) => ({ ...s, room: { theme: (s.room && s.room.theme) === theme ? null : theme } }))}
          room={st.room || {}}
          onPlace={(id) => { const adding = !st.placed.includes(id); setSt((s) => ({ ...s, placed: adding ? [...s.placed, id] : s.placed.filter((p) => p !== id), screen: adding ? 'home' : s.screen, pendingEdit: adding ? true : s.pendingEdit })); }}>
        <\u002FShopScreen>
      ),
    };
    frame = (
      <PhoneFrame>
        <div id="bgScreen" style={{ flex: 1, minHeight: 0, overflowY: 'auto' }}>
          {screens[st.screen] || screens.home}
        <\u002Fdiv>
        <BottomNav active={st.screen} onNav={nav}><\u002FBottomNav>
      <\u002FPhoneFrame>
    );
  }

  return (
    <div style={{ transform: `scale(${scale})` }}>
      {frame}
      {!st.regionSet && (
        <RegionModal regions={Object.keys(REGION_TARIFF)} onSelect={(r) => patch({ region: r, regionSet: true })}><\u002FRegionModal>
      )}
      {showAttend && st.regionSet && st.onboarded && (
        <AttendanceModal streak={streak} reward={5} onClaim={() => { patch({ coins: st.coins + 5, lastAttend: new Date().toDateString() }); setShowAttend(false); }}><\u002FAttendanceModal>
      )}
      <TweaksPanel>
        <TweakSection label="시나리오"><\u002FTweakSection>
        <TweakRadio label="오늘 사용량" value={t.scenario} options={['절약', '보통', '초과']} onChange={(v) => setTweak('scenario', v)}><\u002FTweakRadio>
        <TweakSection label="캐릭터"><\u002FTweakSection>
        <TweakSelect label="방울이 상태" value={t.stage} options={['자동', '1 촉촉함', '2 조금 마름', '3 마름', '4 많이 마름', '5 바싹 마름']} onChange={(v) => setTweak('stage', v)}><\u002FTweakSelect>
        <TweakSection label="데모"><\u002FTweakSection>
        <TweakButton label="오늘 기록 초기화" onClick={() => patch({ recorded: false, usage: 0 })}><\u002FTweakButton>
        <TweakButton label="처음부터 (온보딩 다시 보기)" onClick={() => { setSt((prev) => { const keep = { coins: prev.coins, owned: prev.owned, equipped: prev.equipped }; const ns = { ...DEFAULT_STATE, ...keep }; localStorage.setItem(STORE_KEY, JSON.stringify(ns)); return ns; }); }}><\u002FTweakButton>
        <TweakButton label="완전 초기화 (전부 리셋)" onClick={() => { localStorage.removeItem(STORE_KEY); setSt({ ...DEFAULT_STATE }); }}><\u002FTweakButton>
      <\u002FTweaksPanel>
    <\u002Fdiv>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App><\u002FApp>);
<\u002Fscript>


<\u002Fbody><\u002Fhtml>